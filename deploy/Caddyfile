# HTTPS in front of the app. Caddy gets the Let's Encrypt certificate for
# APP_DOMAIN by itself and renews it before it expires; plain http:// requests
# are sent on to https://.
{
	email {$ACME_EMAIL}
	# Certificates through Cloudflare's DNS check, while a Cloudflare token is set
	# (deploy.sh writes tls/cloudflare.caddy; README.md, "HTTPS behind Cloudflare").
	# Without it, Let's Encrypt checks over port 80 as always.
	import tls/*.caddy

	# The visitor's own address, also behind Cloudflare's proxy (the orange
	# cloud), where every request reaches here from a Cloudflare address: only
	# a request that comes from one of Cloudflare's published ranges may name
	# its visitor, in CF-Connecting-IP. The ranges are Cloudflare's own list
	# (https://www.cloudflare.com/ips), which deploy/cloudflare-ips.sh fetches
	# every day into cloudflare/trusted.caddy ("trusted_proxies static ..."),
	# keeping the last good list when a fetch fails (deploy/cloudflare-ips.txt
	# stands in before the first one). Anyone else is known by the address they
	# connect from, whatever headers they send, so nobody can pretend to be
	# another address (Bug Guard blocks a place by its address). Strict:
	# X-Forwarded-For is read from the right, so an address a visitor typed in
	# front is never taken.
	servers {
		import cloudflare/*.caddy
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Uploads are at most 10 MB each (packing-list photos, bill scans, templates).
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The app gets only the address settled above (src/lib/request-meta.ts),
	# never a list a visitor could have started.
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {client_ip}
	}

	log {
		output stdout
		format json
	}
}

# The demo site, while it is on (deploy/demo.caddy; README.md, "The demo site").
import sites/*.caddy
