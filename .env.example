# -----------------------------------------------------------------------------
# Extras ERP — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---------------------------------------------------
# Matches the local database started by `npm run db:up` (docker-compose.yml).
POSTGRES_USER=extras
POSTGRES_PASSWORD=change-me
POSTGRES_DB=extras_erp
DATABASE_URL=postgresql://extras:change-me@localhost:5432/extras_erp?schema=public

# --- Auth / security ---------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# 32-byte key for encrypting stored integration credentials (courier, WhatsApp...)
ENCRYPTION_KEY=

# --- File storage --------------------------------------------------------------
# Folder for uploaded files (logos, packing-list photos, templates, PDFs).
UPLOAD_DIR=./storage/uploads

# --- Integrations (filled in when each module is built) ----------------------
# Courier: Pathao
PATHAO_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
# Courier: Steadfast
STEADFAST_BASE_URL=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# AI stock intake (packing-list OCR): a Claude API key and the vision-capable
# Claude model to use. Both are needed; without them deliveries are typed in.
AI_API_KEY=
AI_INTAKE_MODEL=
# Google Drive backups
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- First-run seed (`npm run db:seed`) ---------------------------------------
# The platform owner account and the companies created on first setup.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_COMPANIES=Extras,Fabric Apparel
