# -----------------------------------------------------------------------------
# Extas ERP server settings (deploy/.env). configure.sh writes this file with
# fresh passwords and keys; this copy only shows what each setting is.
# Keep deploy/.env private. Every backup carries it, locked with the owner's
# recovery key (Settings > Backups), so a restore brings it back.
# -----------------------------------------------------------------------------

# --- Web address ---------------------------------------------------------------
# The ERP's address. Its DNS "A" record must point at the server's public IP.
APP_DOMAIN=erp.example.com
# Let's Encrypt sends certificate notices here.
ACME_EMAIL=you@example.com

# --- Database ------------------------------------------------------------------
POSTGRES_DB=extras_erp
# The database administrator ("postgres"); only needed for maintenance.
POSTGRES_PASSWORD=
# The app's own database user. Set once: changing these after the first start
# does not change them inside the database.
APP_DB_USER=extras_app
APP_DB_PASSWORD=
# Memory for PostgreSQL. These suit a 4 to 8 GB server; on a 16 GB one use
# 2GB and 8GB.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB

# --- App -----------------------------------------------------------------------
# Locks stored credentials (the Google Drive connection). Never change or lose
# it: a new key means connecting Google Drive again.
ENCRYPTION_KEY=
# Written only by the restore (deploy/bootstrap.sh) onto a server that keeps its
# own ENCRYPTION_KEY: the restored server's key(s), comma-separated, which only
# open what they sealed. Usually empty.
ENCRYPTION_OLD_KEYS=

# --- Folders on the server -------------------------------------------------------
# Database files, uploaded files, backups and HTTPS certificates live here.
DATA_DIR=/srv/extras-erp

# --- Google Drive for the backups ---------------------------------------------------
# An OAuth client of type "TVs and Limited Input devices" from Google Cloud console,
# with the Google Drive API on, the drive.file scope and the app "In production"
# (deploy/README.md, "Backups"). Sign-in is with a code on a phone: no redirect URI.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# --- Cloudflare (optional) -----------------------------------------------------------
# Written by the restore from the token saved on the Backups screen (it can only edit
# DNS for the domain). While it is set, HTTPS certificates come through Cloudflare's
# DNS check, which works with Cloudflare's proxy on. Empty: the usual HTTP check.
CLOUDFLARE_API_TOKEN=

# --- AI (optional) -----------------------------------------------------------------
# AI is switched on, and its Claude key and models are set, in the app (AI Center).
# A key here is only used by companies that have not saved their own key there.
AI_API_KEY=

# --- Outside services (later; see deploy/README.md "Outside services") ---------------
# Each stays off while empty. "log" is a test mode: nothing is sent, the server log shows it.
# SMS codes: off, log or http. For http, the gateway's address with {to} {to_local} {text}
# {sender} {key} filled in, e.g. https://sms.example/send?key={key}&to={to}&msg={text}
SMS_PROVIDER=
SMS_HTTP_URL=
SMS_HTTP_METHOD=
SMS_HTTP_BODY=
SMS_HTTP_SUCCESS=
SMS_API_KEY=
SMS_SENDER_ID=
# Push notifications to phones: off or log.
PUSH_PROVIDER=
# bKash / Nagad payouts: off or log.
PAYOUT_PROVIDER=
# Google Maps for the staff map (limit the key to the ERP's address in Google Cloud).
GOOGLE_MAPS_API_KEY=

# --- The demo site (README.md, "The demo site") ---------------------------------------
# deploy/demo.conf turns it on for every server; DEMO_SITE=off here turns it off on this one.
# Its address, when not demo.<the ERP's domain>; its DNS "A" record points at the same IP.
DEMO_DOMAIN=
# deploy.sh adds these the first time the demo site starts: its own passwords and key.
DEMO_POSTGRES_PASSWORD=
DEMO_APP_DB_PASSWORD=
DEMO_ENCRYPTION_KEY=

# --- First owner account (create-owner.sh) ------------------------------------------
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_NAME=Owner
SEED_COMPANIES=Extas,Fabric Apparel
