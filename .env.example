# -----------------------------------------------------------------------------
# Extas ERP — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---------------------------------------------------
# Matches the local database started by `npm run db:up` (docker-compose.yml).
POSTGRES_USER=extras
POSTGRES_PASSWORD=change-me
POSTGRES_DB=extras_erp
DATABASE_URL=postgresql://extras:change-me@localhost:5432/extras_erp?schema=public

# --- Auth / security ---------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Key for encrypting stored credentials (the Google Drive connection, later courier
# and WhatsApp keys). Generate with: openssl rand -base64 32. Keep it: changing it
# means connecting Google Drive again.
ENCRYPTION_KEY=

# --- File storage --------------------------------------------------------------
# Folder for uploaded files (logos, packing-list photos, templates, PDFs).
UPLOAD_DIR=./storage/uploads

# --- Integrations (filled in when each module is built) ----------------------
# Courier: Pathao
PATHAO_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
# Courier: Steadfast
STEADFAST_BASE_URL=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# AI stock intake (packing-list OCR): a Claude API key and the vision-capable
# Claude model to use. Both are needed; without them deliveries are typed in.
AI_API_KEY=
AI_INTAKE_MODEL=

# --- Daily backups -------------------------------------------------------------
# Where backups are kept on the server (a Docker volume in production).
BACKUP_DIR=./storage/backups
# pg_dump from the PostgreSQL 16 client tools (apt install postgresql-client-16).
PG_DUMP_PATH=pg_dump
# The daily backup clock runs in production and not in development; uncomment to
# choose yourself.
# BACKUP_SCHEDULER=on
# Google Drive (Google One) copy of each backup. Create an OAuth client of type
# "Web application" in Google Cloud console (APIs & Services > Credentials), enable
# the Google Drive API, and add this authorised redirect URI:
#   <APP_URL>/api/backups/google/callback
# Then the platform owner connects their Google account from the backup settings.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# --- Reminders -----------------------------------------------------------------
# The reminder clock sends in-app reminders (deadlines, goods in-house, shipments,
# licence renewals, tasks) every minute. It runs in production and not in
# development; uncomment to choose yourself.
# REMINDER_SCHEDULER=on

# --- Nightly housekeeping ------------------------------------------------------
# Every night at 03:30 Bangladesh time (and once soon after the server starts),
# idle buyers become dormant, settled accounts close and expired sign-ins are
# removed. It runs in production and not in development; uncomment to choose.
# HOUSEKEEPING_SCHEDULER=on

# --- First-run seed (`npm run db:seed`) ---------------------------------------
# The platform owner account and the companies created on first setup.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_COMPANIES=Extras,Fabric Apparel
