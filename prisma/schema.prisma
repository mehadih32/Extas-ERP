// =============================================================================
//  EXTRAS ENTERPRISE ERP — Prisma schema (Blueprint v1.6)
// =============================================================================
//
//  Conventions
//  -----------
//  * PostgreSQL + Prisma. All primary keys are cuid() strings.
//  * Multi-tenancy: every business record carries `companyId` and is isolated
//    per company (e.g. "Extras", "Fabric Apparel"). Users are global and join
//    companies through `CompanyMembership`, each with one `Role`.
//  * Money uses Decimal(14,2); unit costs use Decimal(14,4); quantities are Int
//    (pieces) except raw materials, which use Decimal(14,3) (metres, kg, ...).
//  * Accounting is double-entry: every financial event posts a `JournalEntry`
//    with balanced `JournalLine`s. Buyer/Supplier lifetime ledgers are the
//    journal lines tagged with that `partyId`.
//  * Stock is tracked as a running balance (`StockBalance`) plus an immutable
//    movement log (`StockMovement`) that explains every change.
//
//  Sections
//  --------
//   1. Tenancy, users, RBAC, audit, preferences, files, numbering
//   2. Catalog & product matrix (category -> brand -> style -> variant)
//   3. Inventory, raw materials, bad stock
//   4. Parties (buyers & suppliers), grading, verification, dormancy
//   5. Sales: quotations, proforma, orders, 3-document flow, payments
//   6. E-commerce sync, couriers, returns QC
//   7. Production projects, costing, split bills, AI stock intake
//   8. Accounts & finance (chart of accounts, journal, banks, assets, capital)
//   9. Expenses & marketing spend
//  10. HR, payroll, leave, salary advances, conveyance
//  11. Compliance, dynamic templates, generated documents, reports
//  12. Notepad, tasks, reminders, notifications
//  13. Backups
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. TENANCY, USERS, RBAC, AUDIT
// =============================================================================

/// A distinct business entity. All data is isolated per company.
model Company {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  legalName             String?
  // Letterhead / branding info used on every PDF & the blank letterhead pad
  logoUrl               String?
  /// Uploaded logo (PNG or JPG) printed on the letterhead of every PDF.
  logoFileId            String?   @unique
  address               String?
  phone                 String?
  email                 String?
  website               String?
  letterheadFooter      String?
  primaryColor          String    @default("#0B3D2E")
  accentColor           String    @default("#BE1434")
  currency              String    @default("BDT")
  timezone              String    @default("Asia/Dhaka")
  /// When the terms of employment staff must have agreed to were published (null: no terms yet).
  /// Staff linked to a login agree before they work in the app (hr/terms.service.ts).
  termsRequiredSince    DateTime?
  // Business rules
  lowStockThreshold     Int       @default(5)
  defaultAdvancePercent Decimal   @default(30) @db.Decimal(5, 2)
  dormantAfterMonths    Int       @default(6)
  fiscalYearStartMonth  Int       @default(7) // 7 = July (Bangladesh income year July-June)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships          CompanyMembership[]
  sessions             Session[]
  roles                Role[]
  auditLogs            AuditLog[]
  files                FileAsset[]               @relation("CompanyFiles")
  logoFile             FileAsset?                @relation("CompanyLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  sequences            DocumentSequence[]
  customFields         CustomFieldDefinition[]
  categories           Category[]
  brands               Brand[]
  styles               Style[]
  colors               Color[]
  sizes                Size[]
  variants             ProductVariant[]
  ratioPresets         SizeRatioPreset[]
  warehouses           Warehouse[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  stockLots            StockLot[]
  rawMaterials         RawMaterial[]
  rawMaterialMovements RawMaterialMovement[]
  badStockEntries      BadStockEntry[]
  rawMaterialStocks    RawMaterialStock[]
  purchaseOrders       PurchaseOrder[]
  materialIssues       MaterialIssue[]
  materialChallans     MaterialChallan[]
  purchaseReturns      PurchaseReturn[]
  parties              Party[]
  campaigns            ReEngagementCampaign[]
  quotations           Quotation[]
  proformaInvoices     ProformaInvoice[]
  salesOrders          SalesOrder[]
  invoices             Invoice[]
  packingLists         PackingList[]
  deliveryChallans     DeliveryChallan[]
  payments             Payment[]
  refunds              Refund[]
  creditAllocations    CreditAllocation[]
  cheques              Cheque[]
  integrations         SalesChannelIntegration[]
  webhookEvents        WebhookEvent[]
  courierAccounts      CourierAccount[]
  shipments            Shipment[]
  salesReturns         SalesReturn[]
  productionProjects   ProductionProject[]
  productionBatches    ProductionBatch[]
  productionContracts  ProductionContract[]
  supplierFaults       SupplierFault[]
  cuttingReports       CuttingReport[]
  embroideryJobs       EmbroideryJob[]
  finishingReports     FinishingReport[]
  cmSettlements        CmSettlement[]
  materialNeeds        ProductionMaterialNeed[]
  supplierBills        SupplierBill[]
  stockIntakes         StockIntake[]
  ledgerAccounts       LedgerAccount[]
  journalEntries       JournalEntry[]
  bankAccounts         BankAccount[]
  pettyCashBoxes       PettyCashBox[]
  fixedAssets          FixedAsset[]
  capitalSources       CapitalSource[]
  expenseHeads         ExpenseHead[]
  expenses             Expense[]
  adSpends             AdSpend[]
  employees            Employee[]
  hrSettings           HrSettings?
  holidays             Holiday[]
  attendance           Attendance[]
  leaveTypes           LeaveType[]
  leaveRequests        LeaveRequest[]
  payrollRuns          PayrollRun[]
  payrollPayments      PayrollPayment[]
  salaryAdvances       SalaryAdvance[]
  complianceDocuments  ComplianceDocument[]
  templates            DocumentTemplate[]
  generatedDocuments   GeneratedDocument[]
  reportExports        ReportExport[]
  notes                Note[]
  tasks                Task[]
  reminders            Reminder[]
  reminderRules        ReminderRule[]
  notifications        NotificationLog[]
  projectSettlements   ProjectSettlement[]
  salesTargets         SalesTarget[]
  payDetailsRequests   PayDetailsRequest[]
  employeeDocuments    EmployeeDocument[]
  termsVersions        TermsVersion[]
  termsAcceptances     TermsAcceptance[]
  oneTimeCodes         OneTimeCode[]
  backgroundJobs       BackgroundJob[]
  workLocations        WorkLocation[]
  locationPings        LocationPing[]
  staffPositions       StaffPosition[]
  overtimeEntries      OvertimeEntry[]
  staffClaims          StaffClaim[]
  notices              Notice[]
  noticeReads          NoticeRead[]
  payrollPaymentLines  PayrollPaymentLine[]
  employeeAssets       EmployeeAsset[]
}

/// A person who can log in. Global across companies.
model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  phone              String?
  name               String
  passwordHash       String?
  avatarUrl          String?
  status             UserStatus @default(ACTIVE)
  isSuperAdmin       Boolean    @default(false) // platform-wide owner
  lastLoginAt        DateTime?
  lastCompanyId      String? // remembers the company switcher selection
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime? // temporary lockout after repeated failed logins
  passwordChangedAt  DateTime?
  mustChangePassword Boolean    @default(false) // set for invited users with a temporary password
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  memberships         CompanyMembership[]
  sessions            Session[]
  preference          UserPreference?
  auditLogs           AuditLog[]
  employeeProfiles    Employee[]
  uploadedFiles       FileAsset[]
  forceOverrides      SalesOrderItem[]      @relation("ForceOverrideBy")
  returnInspections   SalesReturnItem[]     @relation("ReturnInspectedBy")
  notes               Note[]
  tasksCreated        Task[]                @relation("TaskCreatedBy")
  remindersCreated    Reminder[]            @relation("ReminderCreatedBy")
  remindersAcked      Reminder[]            @relation("ReminderAcknowledgedBy")
  reminderTargets     ReminderRecipient[]
  reminderRules       ReminderRule[]        @relation("ReminderRuleUpdatedBy")
  notifications       NotificationLog[]
  reportExports       ReportExport[]
  journalEntries      JournalEntry[]        @relation("JournalPostedBy")
  approvedLeaves      LeaveRequest[]        @relation("LeaveApprovedBy")
  requestedLeaves     LeaveRequest[]        @relation("LeaveRequestedBy")
  attendanceMarked    Attendance[]          @relation("AttendanceRecordedBy")
  overtimeDecided     OvertimeEntry[]       @relation("OvertimeDecidedBy")
  claimsDecided       StaffClaim[]          @relation("StaffClaimDecidedBy")
  claimsPaid          StaffClaim[]          @relation("StaffClaimPaidBy")
  claimsCreated       StaffClaim[]          @relation("StaffClaimCreatedBy")
  noticesPosted       Notice[]              @relation("NoticeCreatedBy")
  noticesTakenDown    Notice[]              @relation("NoticeTakenDownBy")
  noticeReads         NoticeRead[]
  assetsIssued        EmployeeAsset[]       @relation("EmployeeAssetIssuedBy")
  assetsTakenBack     EmployeeAsset[]       @relation("EmployeeAssetReturnedTo")
  payrollsCreated     PayrollRun[]          @relation("PayrollCreatedBy")
  payrollsApproved    PayrollRun[]          @relation("PayrollApprovedBy")
  salariesPaid        PayrollPayment[]      @relation("PayrollPaidBy")
  advancesGiven       SalaryAdvance[]       @relation("AdvanceCreatedBy")
  generatedDocs       GeneratedDocument[]
  backupRuns          BackupRun[]
  expensesCreated     Expense[]             @relation("ExpenseCreatedBy")
  pettyCashHeld       PettyCashBox[]        @relation("PettyCashHolder")
  purchaseOrders      PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  materialIssues      MaterialIssue[]       @relation("MaterialIssueCreatedBy")
  materialChallans    MaterialChallan[]     @relation("MaterialChallanCreatedBy")
  productionBatches   ProductionBatch[]     @relation("ProductionBatchCreatedBy")
  contractsMade       ProductionContract[]  @relation("ProductionContractCreatedBy")
  contractsChanged    ProductionContract[]  @relation("ProductionContractUpdatedBy")
  faultsLogged        SupplierFault[]       @relation("SupplierFaultCreatedBy")
  faultsSettled       SupplierFault[]       @relation("SupplierFaultSettledBy")
  cuttingReports      CuttingReport[]       @relation("CuttingReportCreatedBy")
  finishingReports    FinishingReport[]     @relation("FinishingReportCreatedBy")
  cmSettlementsMade   CmSettlement[]        @relation("CmSettlementCreatedBy")
  cmSettlementsUndone CmSettlement[]        @relation("CmSettlementUndoneBy")
  embroideryJobs      EmbroideryJob[]       @relation("EmbroideryJobCreatedBy")
  purchaseReturns     PurchaseReturn[]      @relation("PurchaseReturnCreatedBy")
  materialMovements   RawMaterialMovement[] @relation("MaterialMovementBy")
  refunds             Refund[]              @relation("RefundCreatedBy")
  salesReturns        SalesReturn[]         @relation("SalesReturnCreatedBy")
  creditAllocations   CreditAllocation[]    @relation("CreditAllocatedBy")
  chequesRecorded     Cheque[]              @relation("ChequeRecordedBy")
  intakesReversed     StockIntake[]         @relation("IntakeReversedBy")
  settlementsMade     ProjectSettlement[]   @relation("SettlementMadeBy")
  linesCleared        JournalLine[]         @relation("JournalLineClearedBy")
  salesTargetsSet     SalesTarget[]         @relation("SalesTargetSetBy")
  payRequestsMade     PayDetailsRequest[]   @relation("PayDetailsRequestedBy")
  payRequestsDecided  PayDetailsRequest[]   @relation("PayDetailsDecidedBy")
  employeeDocsAdded   EmployeeDocument[]    @relation("EmployeeDocumentAddedBy")
  termsWritten        TermsVersion[]        @relation("TermsVersionCreatedBy")
  termsPublished      TermsVersion[]        @relation("TermsVersionPublishedBy")
  termsAgreed         TermsAcceptance[]     @relation("TermsAcceptedBy")
  oneTimeCodes        OneTimeCode[]
}

/// A signed-in device. `token` stores the SHA-256 hash of the cookie value, never
/// the raw token. `activeCompanyId` is the company selected in the switcher.
model Session {
  id              String   @id @default(cuid())
  userId          String
  token           String   @unique
  activeCompanyId String?
  userAgent       String?
  ipAddress       String?
  expiresAt       DateTime
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompany Company? @relation(fields: [activeCompanyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

/// Links a user to a company with one role (data isolation boundary).
model CompanyMembership {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  roleId    String
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              Role               @relation(fields: [roleId], references: [id])
  permissionChanges MemberPermission[]

  @@unique([companyId, userId])
  @@index([roleId])
}

/// One person's change to what their role gives them (Settings > Team, the
/// permission matrix): `granted` true adds a permission the role lacks, false
/// takes away one it has. Applied on every request on top of the role
/// (rbac/resolve.ts); Super Admins always keep every permission. Changing the
/// person's role clears them.
model MemberPermission {
  membershipId String
  permissionId String
  granted      Boolean

  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission        @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([membershipId, permissionId])
  @@index([permissionId])
}

/// A role inside a company. The five blueprint roles plus Accounts are seeded as
/// system roles; companies can add custom roles too.
model Role {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  systemRole  SystemRole? // set for the built-in roles
  description String?
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships CompanyMembership[]

  @@unique([companyId, name])
}

/// A single capability, e.g. "invoice.create", "stock.force_override".
model Permission {
  id          String    @id @default(cuid())
  key         String    @unique
  module      AppModule
  description String?

  roles   RolePermission[]
  members MemberPermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Per-user UI preferences (e.g. which dashboard metric cards are hidden 👁).
model UserPreference {
  id              String         @id @default(cuid())
  userId          String         @unique
  hiddenMetrics   String[] // e.g. ["NET_PROFIT", "LIABILITIES"]
  dashboardLayout Json?
  interfaceStyle  InterfaceStyle @default(LEGACY)
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Security / activity log for critical actions (force overrides, edits, deletions...).
model AuditLog {
  id         String      @id @default(cuid())
  companyId  String? // null for platform-level events (e.g. login before a company is chosen)
  userId     String?
  action     AuditAction
  entityType String // e.g. "Invoice", "SalesOrderItem"
  entityId   String?
  summary    String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([userId])
}

/// The sales a company aims for in a month: the bar on the Home screen. Measured
/// as the month's sales after discounts, without VAT and delivery charges (the
/// same figure as "Today's sales"). A month with no row of its own uses the
/// latest earlier month's target.
model SalesTarget {
  id        String   @id @default(cuid())
  companyId String
  /// The first day of the month ("2026-10-01").
  month     DateTime @db.Date
  amount    Decimal  @db.Decimal(14, 2)
  setById   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  setBy   User?   @relation("SalesTargetSetBy", fields: [setById], references: [id], onDelete: SetNull)

  @@unique([companyId, month])
}

/// Any uploaded file (logos, packing-list photos, templates, compliance scans, PDFs).
model FileAsset {
  id           String   @id @default(cuid())
  companyId    String
  uploadedById String?
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String // local path or object-storage key
  url          String?
  checksum     String?
  createdAt    DateTime @default(now())

  company    Company  @relation("CompanyFiles", fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  logoOf     Company? @relation("CompanyLogo")

  stockIntakes        StockIntake[]
  complianceDocuments ComplianceDocument[]
  templates           DocumentTemplate[]
  generatedDocuments  GeneratedDocument[]
  reportExports       ReportExport[]
  supplierBills       SupplierBill[]
  expenses            Expense[]
  leaveRequests       LeaveRequest[]
  paymentProofs       Payment[]                @relation("PaymentProof")
  chequeProofs        Cheque[]                 @relation("ChequeProof")
  quotationImages     QuotationItem[]          @relation("QuotationItemImage")
  employeeDocuments   EmployeeDocument[]
  staffClaims         StaffClaim[]
  materialNeedImages  ProductionMaterialNeed[] @relation("MaterialNeedImage")
  orderLineImages     PurchaseOrderLine[]      @relation("PurchaseOrderLineImage")
  cuttingPhotos       CuttingReport[]          @relation("CuttingPhoto")
  finishingFiles      FinishingReport[]        @relation("FinishingFile")
  faultPhotos         SupplierFault[]          @relation("SupplierFaultPhoto")

  @@index([companyId])
}

/// Auto-numbering per company and document type (e.g. INV-2026-00042).
model DocumentSequence {
  id          String       @id @default(cuid())
  companyId   String
  docType     DocumentType
  prefix      String
  nextNumber  Int          @default(1)
  padding     Int          @default(5)
  resetYearly Boolean      @default(true)
  year        Int?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, docType])
}

/// Dynamic custom fields (e.g. extra quotation styling fields). Values are stored
/// in the `customFields` JSON column of the target record, keyed by `key`.
model CustomFieldDefinition {
  id         String            @id @default(cuid())
  companyId  String
  entity     CustomFieldEntity
  key        String
  label      String
  fieldType  CustomFieldType
  options    String[] // for SELECT fields
  isRequired Boolean           @default(false)
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entity, key])
}

// =============================================================================
// 2. CATALOG & PRODUCT MATRIX
// =============================================================================

/// Tree navigation: Category (self-nesting) -> Brand -> Style -> Matrix.
model Category {
  id        String   @id @default(cuid())
  companyId String
  parentId  String?
  name      String
  slug      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           Category[]          @relation("CategoryTree")
  styles             Style[]
  quotationItems     QuotationItem[]
  productionProjects ProductionProject[]

  @@unique([companyId, slug])
}

model Brand {
  id        String   @id @default(cuid())
  companyId String
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  styles  Style[]

  @@unique([companyId, name])
}

/// Master style (e.g. "Classic Polo — EX-PL-001"). Variants form the color x size matrix.
model Style {
  id             String   @id @default(cuid())
  companyId      String
  categoryId     String
  brandId        String?
  code           String
  name           String
  description    String?
  fabric         String?
  imageUrl       String?
  retailPrice    Decimal  @default(0) @db.Decimal(14, 2)
  wholesalePrice Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           Category            @relation(fields: [categoryId], references: [id])
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  quotationItems     QuotationItem[]
  productionProjects ProductionProject[]
  stockLots          StockLot[]

  @@unique([companyId, code])
  @@index([companyId, categoryId])
}

/// Matrix rows — colors with a visual hex swatch.
model Color {
  id        String @id @default(cuid())
  companyId String
  name      String
  hexCode   String // e.g. "#0B3D2E"
  sortOrder Int    @default(0)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([companyId, name])
}

/// Matrix columns — sizes S to 3XL (or any custom set), ordered by sortOrder.
model Size {
  id        String @id @default(cuid())
  companyId String
  name      String // S, M, L, XL, XXL, 3XL
  sortOrder Int    @default(0)

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variants     ProductVariant[]
  ratioEntries SizeRatioEntry[]

  @@unique([companyId, name])
}

/// One SKU = one cell of the matrix (style + color + size).
model ProductVariant {
  id             String    @id @default(cuid())
  companyId      String
  styleId        String
  colorId        String
  sizeId         String
  sku            String
  barcode        String?
  retailPrice    Decimal?  @db.Decimal(14, 2) // overrides style price when set
  wholesalePrice Decimal?  @db.Decimal(14, 2)
  /// Weighted average cost of the A-grade (sellable) pieces: COGS, stock value.
  avgCost        Decimal   @default(0) @db.Decimal(14, 4)
  /// Weighted average cost of the B-grade pieces, kept apart so a cheaper
  /// B-grade piece never lowers the cost of the A-grade ones.
  bGradeAvgCost  Decimal   @default(0) @db.Decimal(14, 4)
  isActive       Boolean   @default(true)
  /// Taken off the style's matrix with its colour or size. It has history, so it
  /// is kept (not for sale) for the reports; ticking the colour and size again
  /// brings it back.
  removedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style             Style                  @relation(fields: [styleId], references: [id], onDelete: Cascade)
  color             Color                  @relation(fields: [colorId], references: [id])
  size              Size                   @relation(fields: [sizeId], references: [id])
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  badStockEntries   BadStockEntry[]
  orderItems        SalesOrderItem[]
  returnItems       SalesReturnItem[]
  intakeLines       StockIntakeLine[]
  packingListItems  PackingListItem[]
  challanItems      DeliveryChallanItem[]
  productionTargets ProductionTargetLine[]

  @@unique([companyId, sku])
  @@unique([styleId, colorId, sizeId])
  @@index([companyId, barcode])
}

/// Saved "Ratio Fill" shortcut for the wholesale matrix (e.g. S:1 M:2 L:2 XL:1).
model SizeRatioPreset {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries SizeRatioEntry[]

  @@unique([companyId, name])
}

model SizeRatioEntry {
  id       String @id @default(cuid())
  presetId String
  sizeId   String
  ratio    Int

  preset SizeRatioPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  size   Size            @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([presetId, sizeId])
}

// =============================================================================
// 3. INVENTORY, RAW MATERIALS, BAD STOCK
// =============================================================================

model Warehouse {
  id        String    @id @default(cuid())
  companyId String
  name      String
  address   String?
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  /// Set when a Super Admin deletes an empty warehouse: it leaves every list and
  /// picker, while its past movements keep their warehouse in the history.
  deletedAt DateTime?

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  rawMaterialMovements RawMaterialMovement[]
  salesOrders          SalesOrder[]
  stockIntakes         StockIntake[]
  stockLots            StockLot[]
  rawMaterialStocks    RawMaterialStock[]
  supplierBills        SupplierBill[]
  materialIssues       MaterialIssue[]
  purchaseReturns      PurchaseReturn[]
  salesReturns         SalesReturn[]

  @@unique([companyId, name])
}

/// Current quantity per SKU, warehouse and grade. May go negative only via Force Override.
model StockBalance {
  id          String     @id @default(cuid())
  companyId   String
  variantId   String
  warehouseId String
  grade       StockGrade @default(A_GRADE)
  quantity    Int        @default(0)
  reserved    Int        @default(0) // allocated to confirmed but undelivered orders
  updatedAt   DateTime   @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId, grade])
  @@index([companyId, quantity])
}

/// Immutable log explaining every stock change.
model StockMovement {
  id            String            @id @default(cuid())
  companyId     String
  variantId     String
  warehouseId   String
  grade         StockGrade        @default(A_GRADE)
  type          StockMovementType
  quantity      Int // + in, - out
  unitCost      Decimal?          @db.Decimal(14, 4)
  referenceType String? // e.g. "SalesOrder", "StockIntake", "SalesReturn"
  referenceId   String?
  /// The inward batch the pieces came in with (opening stock or a delivery), or
  /// the batch an undone delivery takes them back out of.
  lotId         String?
  note          String?
  createdById   String?
  createdAt     DateTime          @default(now())

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lot       StockLot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
  @@index([lotId])
}

/// An inward batch of one style into one warehouse: opening stock or a delivery
/// from production. It is made, and numbered (LOT-2026-00001), automatically
/// when the pieces come in; its pieces and costs are the movements that name it.
model StockLot {
  id          String         @id @default(cuid())
  companyId   String
  number      String
  styleId     String
  warehouseId String
  source      StockLotSource
  /// The delivery from production it came with (its project and factory follow).
  intakeId    String?
  createdById String?
  createdAt   DateTime       @default(now())

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style     Style           @relation(fields: [styleId], references: [id], onDelete: Cascade)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  intake    StockIntake?    @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  movements StockMovement[]

  @@unique([companyId, number])
  @@index([styleId, createdAt])
  @@index([intakeId])
}

/// Damaged / unsellable pieces written off as inventory loss.
model BadStockEntry {
  id                String         @id @default(cuid())
  companyId         String
  variantId         String
  quantity          Int
  unitCost          Decimal        @db.Decimal(14, 4)
  lossValue         Decimal        @db.Decimal(14, 2)
  source            BadStockSource
  reason            String?
  salesReturnItemId String?        @unique
  journalEntryId    String?        @unique
  createdAt         DateTime       @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant         ProductVariant   @relation(fields: [variantId], references: [id])
  salesReturnItem SalesReturnItem? @relation(fields: [salesReturnItemId], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

/// Fabric, trims, accessories and packaging bought for production: a current
/// asset (Raw Materials & Accessories, 1400) valued at moving average cost.
model RawMaterial {
  id            String          @id @default(cuid())
  companyId     String
  code          String // "FAB-0001", or the company's own code
  name          String
  kind          RawMaterialKind
  unit          MeasurementUnit
  color         String?
  specification String? // e.g. "180 GSM single jersey, 100% cotton, 72 in open width"
  quantity      Decimal         @default(0) @db.Decimal(14, 3) // on hand in every store
  stockValue    Decimal         @default(0) @db.Decimal(14, 2) // its share of the Raw Materials ledger
  avgCost       Decimal         @default(0) @db.Decimal(14, 4) // stockValue / quantity (the last one while none is left)
  reorderLevel  Decimal?        @db.Decimal(14, 3) // low stock at or below this
  supplierId    String? // the usual supplier
  isActive      Boolean         @default(true)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Party?                   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stocks      RawMaterialStock[]
  movements   RawMaterialMovement[]
  orderLines  PurchaseOrderLine[]
  billItems   SupplierBillItem[]
  returnLines PurchaseReturnLine[]
  neededBy    ProductionMaterialNeed[]
  faults      SupplierFault[]

  @@unique([companyId, code])
  @@index([companyId, kind, isActive])
}

/// How much of a raw material sits in one store (warehouse).
model RawMaterialStock {
  id            String   @id @default(cuid())
  companyId     String
  rawMaterialId String
  warehouseId   String
  quantity      Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt     DateTime @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([rawMaterialId, warehouseId])
  @@index([companyId, warehouseId])
}

/// The stock card: every change to a raw material, in the order it was recorded.
/// `quantity` changes the store's stock; `value` changes the material's value
/// (its values add up to `stockValue`, its share of the Raw Materials ledger).
model RawMaterialMovement {
  id                  String                  @id @default(cuid())
  companyId           String
  rawMaterialId       String
  warehouseId         String
  type                RawMaterialMovementType
  date                DateTime                @default(now()) // the bill, issue or count day
  quantity            Decimal                 @db.Decimal(14, 3) // + into, - out of the store
  unitCost            Decimal                 @db.Decimal(14, 4)
  value               Decimal                 @default(0) @db.Decimal(14, 2) // + into, - out of the books
  productionProjectId String? // issued to / returned from this project
  supplierBillId      String? // bought (or voided) on this bill
  issueId             String? // material issue or return note
  purchaseReturnId    String? // sent back to the supplier (debit note)
  transferId          String? // pairs the two sides of a transfer between stores
  journalEntryId      String?
  note                String?
  createdById         String?
  createdAt           DateTime                @default(now())

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rawMaterial       RawMaterial        @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productionProject ProductionProject? @relation(fields: [productionProjectId], references: [id], onDelete: SetNull)
  supplierBill      SupplierBill?      @relation(fields: [supplierBillId], references: [id], onDelete: SetNull)
  issue             MaterialIssue?     @relation(fields: [issueId], references: [id], onDelete: SetNull)
  purchaseReturn    PurchaseReturn?    @relation(fields: [purchaseReturnId], references: [id], onDelete: SetNull)
  journalEntry      JournalEntry?      @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation("MaterialMovementBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([rawMaterialId, createdAt])
  @@index([companyId, type, createdAt])
  @@index([productionProjectId])
  @@index([supplierBillId])
}

/// An order placed with a supplier for raw materials (e.g. a fabric booking). No
/// money moves until the goods arrive with the supplier's bill.
model PurchaseOrder {
  id           String              @id @default(cuid())
  companyId    String
  number       String
  supplierId   String
  projectId    String? // bought for this production project
  /// Bought for the styles of a master batch (one order for all of them).
  batchId      String?
  orderDate    DateTime            @db.Date
  expectedDate DateTime?           @db.Date // when the goods should be in-house
  status       PurchaseOrderStatus @default(OPEN)
  supplierRef  String? // the supplier's PI or booking number
  totalAmount  Decimal             @default(0) @db.Decimal(14, 2)
  notes        String?
  closedReason String? // why it was closed or cancelled before everything came
  closedAt     DateTime?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier  Party               @relation(fields: [supplierId], references: [id])
  project   ProductionProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  batch     ProductionBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines     PurchaseOrderLine[]
  bills     SupplierBill[]
  reminders Reminder[]

  @@unique([companyId, number])
  @@index([companyId, status, expectedDate])
  @@index([supplierId])
  @@index([batchId])
}

model PurchaseOrderLine {
  id            String  @id @default(cuid())
  orderId       String
  rawMaterialId String
  quantity      Decimal @db.Decimal(14, 3)
  unitPrice     Decimal @db.Decimal(14, 4)
  amount        Decimal @db.Decimal(14, 2)
  receivedQty   Decimal @default(0) @db.Decimal(14, 3) // on bills that are not void
  description   String?
  /// The price is agreed when the goods arrive ("price at receive"); unitPrice is 0 until then.
  priceLater    Boolean @default(false)
  /// A sketch or photo for the supplier (the label artwork, the button).
  imageId       String?

  order       PurchaseOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial              @relation(fields: [rawMaterialId], references: [id])
  image       FileAsset?               @relation("PurchaseOrderLineImage", fields: [imageId], references: [id], onDelete: SetNull)
  billItems   SupplierBillItem[]
  shares      PurchaseOrderLineShare[]

  @@index([orderId])
  @@index([rawMaterialId])
}

/// What part of an order line is for which style (and garment colour and size): the
/// style-wise breakdown and the collar and cuff matrices printed on the order.
model PurchaseOrderLineShare {
  id        String  @id @default(cuid())
  lineId    String
  projectId String
  /// The garment colour it is for, when the need is split by colour.
  colorName String?
  /// The garment size, when split by colour and size (collars, cuffs).
  sizeName  String?
  quantity  Decimal @db.Decimal(14, 3)

  line    PurchaseOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  project ProductionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@index([projectId])
}

/// Raw materials bought on a supplier bill and received into the bill's store.
model SupplierBillItem {
  id                  String   @id @default(cuid())
  billId              String
  rawMaterialId       String
  purchaseOrderLineId String?
  quantity            Decimal  @db.Decimal(14, 3)
  /// What the supplier's challan said came (null: not given); `quantity` is what was
  /// actually weighed or counted, and the difference is the Short/Extra.
  challanQuantity     Decimal? @db.Decimal(14, 3)
  unitPrice           Decimal  @db.Decimal(14, 4)
  amount              Decimal  @db.Decimal(14, 2)
  description         String?

  bill              SupplierBill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  rawMaterial       RawMaterial          @relation(fields: [rawMaterialId], references: [id])
  purchaseOrderLine PurchaseOrderLine?   @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  returnLines       PurchaseReturnLine[]

  @@index([billId])
  @@index([purchaseOrderLineId])
}

/// Materials handed from a store to a production project (ISSUE) or brought back
/// unused (RETURN). Issues go out at the store's average cost; returns come back
/// at what the project was charged for them.
model MaterialIssue {
  id             String            @id @default(cuid())
  companyId      String
  number         String
  kind           MaterialIssueKind
  projectId      String
  warehouseId    String
  date           DateTime          @default(now())
  receivedBy     String? // who took the materials (or brought them back)
  note           String?
  totalValue     Decimal           @default(0) @db.Decimal(14, 2)
  journalEntryId String?           @unique
  createdById    String?
  createdAt      DateTime          @default(now())

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      ProductionProject     @relation(fields: [projectId], references: [id])
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id])
  journalEntry JournalEntry?         @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("MaterialIssueCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  movements    RawMaterialMovement[]

  @@unique([companyId, number])
  @@index([projectId, createdAt])
}

/// "Materials sent": a plain record of what went to the factory for a production
/// project (fabric, trims, cartons... as written, with a quantity and unit) under
/// its own challan number (MC-) to print and hand over. It moves no stock and no
/// money; materials taken from the store's stock go out on a MaterialIssue. A
/// challan entered by mistake is cancelled with a reason and stays on record.
model MaterialChallan {
  id            String    @id @default(cuid())
  companyId     String
  number        String
  projectId     String
  sentAt        DateTime  @default(now())
  /// Where it went, as printed: the factory's name (and address).
  sentTo        String
  /// What was sent, line by line: [{ "description": "Oxford fabric", "quantity": 500, "unit": "kg" }].
  items         Json
  /// Vehicle, driver or courier that took it.
  carrier       String?
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   ProductionProject @relation(fields: [projectId], references: [id])
  createdBy User?             @relation("MaterialChallanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([projectId, sentAt])
}

/// Goods sent back to a supplier from one of their bills (a debit note): the
/// supplier owes us the bill price and the goods leave the store.
model PurchaseReturn {
  id             String    @id @default(cuid())
  companyId      String
  number         String
  supplierId     String
  billId         String
  warehouseId    String
  date           DateTime  @default(now())
  reason         String
  totalAmount    Decimal   @db.Decimal(14, 2) // what the supplier credits, at the bill price
  stockValue     Decimal   @db.Decimal(14, 2) // the value that left the store
  journalEntryId String?   @unique
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?
  createdAt      DateTime  @default(now())

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier     Party                 @relation(fields: [supplierId], references: [id])
  bill         SupplierBill          @relation(fields: [billId], references: [id])
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id])
  journalEntry JournalEntry?         @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines        PurchaseReturnLine[]
  movements    RawMaterialMovement[]

  @@unique([companyId, number])
  @@index([billId])
  @@index([supplierId])
}

model PurchaseReturnLine {
  id               String  @id @default(cuid())
  purchaseReturnId String
  billItemId       String
  rawMaterialId    String
  quantity         Decimal @db.Decimal(14, 3)
  unitPrice        Decimal @db.Decimal(14, 4) // the bill price
  amount           Decimal @db.Decimal(14, 2)
  stockValue       Decimal @db.Decimal(14, 2)

  purchaseReturn PurchaseReturn   @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  billItem       SupplierBillItem @relation(fields: [billItemId], references: [id])
  rawMaterial    RawMaterial      @relation(fields: [rawMaterialId], references: [id])

  @@index([purchaseReturnId])
  @@index([billItemId])
}

// =============================================================================
// 4. PARTIES — 360° BUYER & SUPPLIER PROFILES
// =============================================================================

/// A buyer (retail, wholesale, B2B), supplier/factory, or both.
model Party {
  id                 String             @id @default(cuid())
  companyId          String
  code               String
  kind               PartyKind
  buyerType          BuyerType? // only for buyers
  name               String
  contactPerson      String?
  phone              String?
  whatsapp           String?
  email              String?
  address            String?
  city               String?
  country            String?            @default("Bangladesh")
  taxId              String?
  // 360° profile signals
  grade              PartyGrade? // A+, A, B, C
  isVerified         Boolean            @default(false) // 💙 Blue Verified badge
  verifiedAt         DateTime?
  status             PartyStatus        @default(ACTIVE)
  statusChangedAt    DateTime?
  creditLimit        Decimal?           @db.Decimal(14, 2)
  paymentTermsDays   Int?
  openingBalance     Decimal            @default(0) @db.Decimal(14, 2) // + receivable / - payable
  lastTransactionAt  DateTime? // drives dormant buyer filters
  notes              String?
  customFields       Json?
  /// Set on the account the system keeps itself (see PartySystemRole); null for real buyers and suppliers.
  systemRole         PartySystemRole?
  /// What a supplier supplies (any number of them; none for buyers). Fabric, FOB and CM
  /// suppliers are settled project by project; accessories run on a continuous ledger.
  supplierCategories SupplierCategory[] @default([])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company              Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations           Quotation[]
  proformaInvoices     ProformaInvoice[]
  salesOrders          SalesOrder[]
  invoices             Invoice[]
  payments             Payment[]
  refunds              Refund[]
  salesReturns         SalesReturn[]
  creditAllocations    CreditAllocation[]
  cheques              Cheque[]
  journalLines         JournalLine[]
  supplierBills        SupplierBill[]
  expenses             Expense[]
  rawMaterials         RawMaterial[]
  purchaseOrders       PurchaseOrder[]
  purchaseReturns      PurchaseReturn[]
  productionsAsBuyer   ProductionProject[]  @relation("ProductionBuyer")
  productionsAsFactory ProductionProject[]  @relation("ProductionFactory")
  batchesAsFactory     ProductionBatch[]    @relation("BatchFactory")
  productionContracts  ProductionContract[] @relation("ContractParty")
  faults               SupplierFault[]      @relation("SupplierFaults")
  cmSettlements        CmSettlement[]       @relation("CmSettlementFactory")
  embroideryJobs       EmbroideryJob[]      @relation("EmbroideryParty")
  campaignRecipients   CampaignRecipient[]
  generatedDocuments   GeneratedDocument[]
  projectSettlements   ProjectSettlement[]

  @@unique([companyId, code])
  @@unique([companyId, systemRole])
  @@index([companyId, kind, status])
  @@index([companyId, lastTransactionAt])
}

/// One-click re-engagement campaign targeting dormant B2B buyers.
model ReEngagementCampaign {
  id               String         @id @default(cuid())
  companyId        String
  name             String
  inactivityMonths Int // e.g. 6 or 12
  channel          MessageChannel
  message          String
  catalogFileUrl   String? // catalog / stock availability share
  status           CampaignStatus @default(DRAFT)
  scheduledAt      DateTime?
  sentAt           DateTime?
  createdAt        DateTime       @default(now())

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id          String         @id @default(cuid())
  campaignId  String
  partyId     String
  status      DeliveryStatus @default(PENDING)
  sentAt      DateTime?
  respondedAt DateTime?
  error       String?

  campaign ReEngagementCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  party    Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([campaignId, partyId])
}

// =============================================================================
// 5. SALES — QUOTATION -> PROFORMA -> ORDER -> 3 DOCUMENTS
// =============================================================================

model Quotation {
  id           String          @id @default(cuid())
  companyId    String
  number       String
  partyId      String
  status       QuotationStatus @default(DRAFT)
  issueDate    DateTime        @default(now())
  validUntil   DateTime?
  currency     String          @default("BDT")
  subtotal     Decimal         @default(0) @db.Decimal(14, 2)
  discount     Decimal         @default(0) @db.Decimal(14, 2)
  tax          Decimal         @default(0) @db.Decimal(14, 2)
  total        Decimal         @default(0) @db.Decimal(14, 2)
  terms        String?
  notes        String?
  customFields Json? // values for CustomFieldDefinition(entity = QUOTATION)
  templateId   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party        Party                  @relation(fields: [partyId], references: [id])
  template     DocumentTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items        QuotationItem[]
  stylingRules QuotationStylingRule[]
  proforma     ProformaInvoice?

  @@unique([companyId, number])
  @@index([companyId, status])
}

model QuotationItem {
  id            String  @id @default(cuid())
  quotationId   String
  categoryId    String?
  styleId       String?
  description   String
  fabric        String?
  colorNote     String?
  gsm           Int? // fabric weight, grams per square metre
  sizeRatio     String? // e.g. "1:2:2:1" for S:M:L:XL
  accessories   String? // trims, labels, buttons, packing notes
  imageId       String? // reference picture (JPEG or PNG), printed on the PDFs
  sizeBreakdown Json? // e.g. {"S":20,"M":40,"L":40}
  quantity      Int
  unitPrice     Decimal @db.Decimal(14, 2)
  lineTotal     Decimal @db.Decimal(14, 2)
  sortOrder     Int     @default(0)

  quotation Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  style     Style?     @relation(fields: [styleId], references: [id], onDelete: SetNull)
  image     FileAsset? @relation("QuotationItemImage", fields: [imageId], references: [id], onDelete: SetNull)
}

/// Free-text styling instructions, e.g. "Placket should not have a black border".
model QuotationStylingRule {
  id          String  @id @default(cuid())
  quotationId String
  area        String? // e.g. "Placket", "Collar & Cuff", "Logo"
  instruction String
  sortOrder   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

/// Proforma Invoice converted from a quotation; the advance (default 30%) triggers
/// accounts posting and a production project.
model ProformaInvoice {
  id             String         @id @default(cuid())
  companyId      String
  number         String
  quotationId    String?        @unique
  partyId        String
  status         ProformaStatus @default(ISSUED)
  issueDate      DateTime       @default(now())
  total          Decimal        @db.Decimal(14, 2)
  advancePercent Decimal        @default(30) @db.Decimal(5, 2)
  advanceAmount  Decimal        @db.Decimal(14, 2)
  advancePaid    Decimal        @default(0) @db.Decimal(14, 2)
  advancePaidAt  DateTime?
  buyerPoNumber  String? // the buyer's purchase order number, printed on the PI
  validUntil     DateTime?      @db.Date // the PI's offer is valid until the end of this day
  bankAccountId  String? // the account the buyer pays into, printed as bank details
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotation          Quotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  party              Party               @relation(fields: [partyId], references: [id])
  bankAccount        BankAccount?        @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  salesOrder         SalesOrder?
  productionProjects ProductionProject[]
  payments           Payment[]
  refunds            Refund[]
  cheques            Cheque[]

  @@unique([companyId, number])
}

/// A confirmed order from any channel: website, social/POS, wholesale or B2B pre-order.
model SalesOrder {
  id               String           @id @default(cuid())
  companyId        String
  number           String
  channel          SalesChannel
  partyId          String? // null allowed for walk-in retail
  proformaId       String?          @unique
  integrationId    String?
  externalOrderId  String? // id from website / e-commerce platform
  warehouseId      String? // stock is reserved in / shipped from this warehouse
  status           SalesOrderStatus @default(CONFIRMED)
  orderDate        DateTime         @default(now())
  // Retail delivery details
  customerName     String?
  customerPhone    String?
  shippingAddress  String?
  // Totals
  subtotal         Decimal          @default(0) @db.Decimal(14, 2)
  discount         Decimal          @default(0) @db.Decimal(14, 2)
  shippingCharge   Decimal          @default(0) @db.Decimal(14, 2)
  tax              Decimal          @default(0) @db.Decimal(14, 2)
  total            Decimal          @default(0) @db.Decimal(14, 2)
  paidAmount       Decimal          @default(0) @db.Decimal(14, 2)
  dueAmount        Decimal          @default(0) @db.Decimal(14, 2)
  hasForceOverride Boolean          @default(false)
  /// The day the goods are due to ship to the buyer (shipment reminders).
  shipmentDate     DateTime?        @db.Date
  /// Cartons the goods go out in; printed on the packing list and the delivery challan.
  totalCartons     Int?
  /// The employee who packed the goods; printed on the packing list and the challan.
  packedById       String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company            Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party              Party?                   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  proforma           ProformaInvoice?         @relation(fields: [proformaId], references: [id], onDelete: SetNull)
  integration        SalesChannelIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  warehouse          Warehouse?               @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  packedBy           Employee?                @relation("OrderPackedBy", fields: [packedById], references: [id], onDelete: SetNull)
  items              SalesOrderItem[]
  invoice            Invoice?
  packingList        PackingList?
  deliveryChallans   DeliveryChallan[]
  shipments          Shipment[]
  returns            SalesReturn[]
  payments           Payment[]
  refunds            Refund[]
  creditAllocations  CreditAllocation[]
  cheques            Cheque[]
  reminders          Reminder[]
  /// Production projects started from it.
  productionProjects ProductionProject[]

  @@unique([companyId, number])
  @@unique([companyId, integrationId, externalOrderId])
  @@index([companyId, status, orderDate])
  @@index([companyId, shipmentDate])
  @@index([partyId])
}

/// One SKU line. Matrix entry creates one line per non-empty color/size cell.
/// `forceOverride` records when quantity exceeded available stock.
model SalesOrderItem {
  id              String    @id @default(cuid())
  orderId         String
  variantId       String
  quantity        Int
  unitPrice       Decimal   @db.Decimal(14, 2)
  discount        Decimal   @default(0) @db.Decimal(14, 2)
  lineTotal       Decimal   @db.Decimal(14, 2)
  unitCost        Decimal?  @db.Decimal(14, 4) // COGS snapshot at sale
  availableAtSale Int? // stock seen when the line was saved
  forceOverride   Boolean   @default(false)
  overrideById    String?
  overrideReason  String?
  overrideAt      DateTime?

  order       SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  overrideBy  User?             @relation("ForceOverrideBy", fields: [overrideById], references: [id], onDelete: SetNull)
  returnItems SalesReturnItem[]

  @@index([orderId])
  @@index([variantId])
}

/// Document 1: Commercial Invoice (prices, totals, paid/due). Saved permanently.
model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  number         String
  orderId        String        @unique
  partyId        String?
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  total          Decimal       @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  dueAmount      Decimal       @db.Decimal(14, 2)
  status         InvoiceStatus @default(UNPAID)
  isLocked       Boolean       @default(false) // edits after lock are audited
  /// What the buyer already owed when this invoice was issued, printed on it
  /// ("Previous due" and "Total payable"). Null: not shown. Never revenue.
  previousDue    Decimal?      @db.Decimal(14, 2)
  /// The buyer's unused credit (advance balance) at that moment: already taken
  /// off previousDue, so credit later used on this invoice is not counted twice.
  previousCredit Decimal?      @db.Decimal(14, 2)
  /// How many times the invoice was edited after it was issued (Smart Edit): the
  /// number stays, the PDF says "(Revised)". Back to 0 when a void is re-issued.
  revision       Int           @default(0)
  revisedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order             SalesOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  party             Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  payments          Payment[]
  creditAllocations CreditAllocation[]
  returns           SalesReturn[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, issueDate])
}

/// Document 2: Packing List / Pick-List for the warehouse.
model PackingList {
  id            String   @id @default(cuid())
  companyId     String
  number        String
  orderId       String   @unique
  cartons       Int?
  grossWeightKg Decimal? @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime @default(now())

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items   PackingListItem[]

  @@unique([companyId, number])
}

model PackingListItem {
  id            String  @id @default(cuid())
  packingListId String
  variantId     String
  quantity      Int
  cartonNo      String?
  isPicked      Boolean @default(false)

  packingList PackingList    @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
}

/// Document 3: Delivery Challan — price-free transport document.
model DeliveryChallan {
  id           String   @id @default(cuid())
  companyId    String
  number       String
  orderId      String
  deliveryDate DateTime @default(now())
  vehicleNo    String?
  driverName   String?
  driverPhone  String?
  receivedBy   String?
  notes        String?
  createdAt    DateTime @default(now())

  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   SalesOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items   DeliveryChallanItem[]

  @@unique([companyId, number])
}

model DeliveryChallanItem {
  id        String @id @default(cuid())
  challanId String
  variantId String
  quantity  Int

  challan DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id])
}

/// Money received from buyers or paid to suppliers. Always posts a journal entry.
model Payment {
  id             String           @id @default(cuid())
  companyId      String
  number         String
  direction      PaymentDirection
  method         PaymentMethod
  partyId        String?
  amount         Decimal          @db.Decimal(14, 2)
  paymentDate    DateTime         @default(now())
  accountId      String // cash / bank ledger account used
  invoiceId      String?
  orderId        String?
  proformaId     String?
  supplierBillId String?
  shipmentId     String? // courier COD payout
  /// A payment to a supplier for one production project: it settles that project's bills first.
  projectId      String?
  /// A payment to a factory or supplier for a master batch (an advance on its CM): it
  /// settles the bills of the batch's styles first, and what is left stays as an advance.
  batchId        String?
  reference      String? // cheque no, bKash trx id...
  isAdvance      Boolean          @default(false)
  notes          String?
  journalEntryId String?          @unique
  /// A photo of the proof (a transfer screenshot, the cheque), compressed in the browser.
  proofFileId    String?
  /// Money on the buyer's account: what it left as their advance balance once it had
  /// paid invoices and any earlier balance. Null for money on an order or proforma, and
  /// for receipts recorded before this was kept.
  advanceKept    Decimal?         @db.Decimal(14, 2)
  createdAt      DateTime         @default(now())

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party        Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  account      LedgerAccount      @relation(fields: [accountId], references: [id])
  invoice      Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  order        SalesOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  proforma     ProformaInvoice?   @relation(fields: [proformaId], references: [id], onDelete: SetNull)
  supplierBill SupplierBill?      @relation(fields: [supplierBillId], references: [id], onDelete: SetNull)
  shipment     Shipment?          @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  project      ProductionProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  batch        ProductionBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?      @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  proofFile    FileAsset?         @relation("PaymentProof", fields: [proofFileId], references: [id], onDelete: SetNull)
  allocations  CreditAllocation[]
  cheque       Cheque?

  @@unique([companyId, number])
  @@index([companyId, paymentDate])
  @@index([batchId])
  @@index([partyId])
  @@index([projectId])
}

/// Money on a buyer's account (a payment on account, credit kept from a
/// refund) put against one invoiced order: it counts as paid on that order.
/// No journal entry: the money and the invoice are both on the buyer's
/// Receivable already. Released (kept for the record) when the invoice is voided.
model CreditAllocation {
  id            String    @id @default(cuid())
  companyId     String
  partyId       String
  orderId       String
  invoiceId     String
  /// The payment on account this money came in with; null: the buyer's earlier credit.
  paymentId     String?
  amount        Decimal   @db.Decimal(14, 2)
  createdById   String?
  createdAt     DateTime  @default(now())
  releasedAt    DateTime?
  releaseReason String?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party     Party      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment   Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("CreditAllocatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, partyId])
  @@index([orderId])
  @@index([paymentId])
}

/// A cheque received from a buyer. Nothing reaches the books while it is
/// pending; marking it cleared records the payment into the bank account it
/// was deposited in, and a bounced cheque records nothing.
model Cheque {
  id           String       @id @default(cuid())
  companyId    String
  partyId      String?
  orderId      String?
  proformaId   String?
  amount       Decimal      @db.Decimal(14, 2)
  chequeNo     String
  bankName     String?
  /// The day written on the cheque (it cannot be cleared before it).
  chequeDate   DateTime     @db.Date
  receivedAt   DateTime     @default(now())
  status       ChequeStatus @default(PENDING)
  /// A cheque on a buyer's account: how it pays their invoices once cleared,
  /// [{ orderId, amount }]; null with oldestFirst false keeps it all as advance balance.
  allocations  Json?
  oldestFirst  Boolean      @default(false)
  /// The money receipt recorded when it cleared.
  paymentId    String?      @unique
  clearedAt    DateTime?
  bouncedAt    DateTime?
  bounceReason String?
  proofFileId  String?
  notes        String?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party     Party?           @relation(fields: [partyId], references: [id], onDelete: SetNull)
  order     SalesOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  proforma  ProformaInvoice? @relation(fields: [proformaId], references: [id], onDelete: SetNull)
  payment   Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  proofFile FileAsset?       @relation("ChequeProof", fields: [proofFileId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("ChequeRecordedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([partyId])
  @@index([orderId])
}

/// Buyer money taken back off an order, a proforma or the buyer's account:
/// paid back to them (CASH), kept as credit on their account (CREDIT), or kept
/// as a cancellation charge (FORFEIT). What an order or proforma holds is what
/// was received less its refunds that are not void. Each posts one journal
/// entry; a voided refund keeps its row and has that entry reversed.
model Refund {
  id             String         @id @default(cuid())
  companyId      String
  number         String
  kind           RefundKind
  partyId        String? // null: a walk-in customer's order
  orderId        String?
  proformaId     String? // a proforma's refunds move onto its order when it converts
  amount         Decimal        @db.Decimal(14, 2)
  refundDate     DateTime       @default(now())
  method         PaymentMethod? // CASH: how the money went back
  accountId      String? // CASH: the cash / bank / wallet account it was paid from
  reference      String? // cheque no, bKash trx id...
  reason         String
  notes          String?
  journalEntryId String?        @unique
  createdById    String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime       @default(now())

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party        Party?           @relation(fields: [partyId], references: [id], onDelete: SetNull)
  order        SalesOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  proforma     ProformaInvoice? @relation(fields: [proformaId], references: [id], onDelete: SetNull)
  account      LedgerAccount?   @relation(fields: [accountId], references: [id])
  journalEntry JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("RefundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, refundDate])
  @@index([orderId])
  @@index([proformaId])
  @@index([partyId])
}

// =============================================================================
// 6. E-COMMERCE SYNC, COURIERS, RETURNS QC
// =============================================================================

/// A connected website / e-commerce platform that pushes orders via API/Webhook.
model SalesChannelIntegration {
  id               String            @id @default(cuid())
  companyId        String
  name             String
  platform         EcommercePlatform
  baseUrl          String?
  apiKeyRef        String? // reference to an encrypted secret, never the raw key
  webhookSecretRef String?
  isActive         Boolean           @default(true)
  lastSyncedAt     DateTime?
  createdAt        DateTime          @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders        SalesOrder[]
  webhookEvents WebhookEvent[]
}

/// Raw inbound webhook log (orders from websites, courier status updates).
model WebhookEvent {
  id            String        @id @default(cuid())
  companyId     String
  source        WebhookSource
  integrationId String?
  eventType     String
  externalId    String?
  payload       Json
  status        WebhookStatus @default(RECEIVED)
  error         String?
  receivedAt    DateTime      @default(now())
  processedAt   DateTime?

  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integration SalesChannelIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([source, externalId])
}

/// Courier API credentials per company (Pathao / Steadfast).
model CourierAccount {
  id             String          @id @default(cuid())
  companyId      String
  provider       CourierProvider
  name           String
  storeId        String?
  credentialsRef String? // reference to encrypted credentials
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipments Shipment[]

  @@unique([companyId, provider, name])
}

/// A courier consignment created from the ERP.
model Shipment {
  id               String         @id @default(cuid())
  companyId        String
  orderId          String
  courierAccountId String
  consignmentId    String?
  trackingCode     String?
  status           ShipmentStatus @default(PENDING)
  codAmount        Decimal        @default(0) @db.Decimal(14, 2)
  deliveryCharge   Decimal        @default(0) @db.Decimal(14, 2)
  codCharge        Decimal        @default(0) @db.Decimal(14, 2)
  payoutAmount     Decimal?       @db.Decimal(14, 2)
  payoutAt         DateTime?
  deliveredAt      DateTime?
  returnedAt       DateTime?
  lastSyncedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order          SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierAccount CourierAccount  @relation(fields: [courierAccountId], references: [id])
  events         ShipmentEvent[]
  returns        SalesReturn[]
  payments       Payment[]

  @@unique([courierAccountId, consignmentId])
  @@index([companyId, status])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  rawStatus  String? // courier's own status text
  message    String?
  occurredAt DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

/// Goods a buyer sends back. A return against an invoice (a credit note,
/// CN-) credits the buyer at the prices billed and puts the pieces in Damage &
/// QC Rejects at once. A courier's returned parcel (shipmentId) waits in the
/// "Pending Returns to Check" pool until QC.
model SalesReturn {
  id             String       @id @default(cuid())
  companyId      String
  number         String
  orderId        String
  /// The invoice the goods were billed on: its prices are what is credited.
  invoiceId      String?
  partyId        String?
  /// Where the pieces are logged as Damage & QC Rejects (the order's warehouse).
  warehouseId    String?
  shipmentId     String?
  reason         String?
  notes          String?
  status         ReturnStatus @default(PENDING_QC)
  receivedAt     DateTime     @default(now())
  completedAt    DateTime?
  /// The goods at the prices billed, their share of the invoice's discount and VAT,
  /// and what the buyer is credited (goodsValue - discount + tax).
  goodsValue     Decimal      @default(0) @db.Decimal(14, 2)
  discount       Decimal      @default(0) @db.Decimal(14, 2)
  tax            Decimal      @default(0) @db.Decimal(14, 2)
  amount         Decimal      @default(0) @db.Decimal(14, 2)
  /// What the pieces cost when they left: booked to Inventory Loss.
  costValue      Decimal      @default(0) @db.Decimal(14, 2)
  journalEntryId String?      @unique
  createdById    String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime     @default(now())

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order        SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice      Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  party        Party?            @relation(fields: [partyId], references: [id], onDelete: SetNull)
  warehouse    Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  shipment     Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?     @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation("SalesReturnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        SalesReturnItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, receivedAt])
  @@index([invoiceId])
  @@index([orderId])
  @@index([partyId])
}

/// QC decision per returned SKU: Move to Main Stock or Move to Bad Stock.
model SalesReturnItem {
  id            String             @id @default(cuid())
  returnId      String
  variantId     String
  /// The invoice line it came back from.
  orderItemId   String?
  quantity      Int
  /// The price billed per piece (the line's total over its pieces).
  unitPrice     Decimal            @default(0) @db.Decimal(14, 2)
  /// These pieces at the prices billed (before the invoice's discount and VAT).
  amount        Decimal            @default(0) @db.Decimal(14, 2)
  /// What each piece cost when it left the warehouse.
  unitCost      Decimal            @default(0) @db.Decimal(14, 4)
  qcStatus      ReturnItemQcStatus @default(PENDING)
  qtyRestocked  Int                @default(0)
  qtyBadStock   Int                @default(0)
  inspectedById String?
  inspectedAt   DateTime?
  qcNote        String?

  salesReturn   SalesReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant       ProductVariant  @relation(fields: [variantId], references: [id])
  orderItem     SalesOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  inspectedBy   User?           @relation("ReturnInspectedBy", fields: [inspectedById], references: [id], onDelete: SetNull)
  badStockEntry BadStockEntry?

  @@index([returnId])
  @@index([orderItemId])
  @@index([qcStatus])
}

// =============================================================================
// 7. PRODUCTION, BATCH COSTING, SPLIT BILLS, AI STOCK INTAKE
// =============================================================================

model ProductionProject {
  id             String           @id @default(cuid())
  companyId      String
  code           String
  name           String
  categoryId     String?
  styleId        String?
  factoryId      String? // supplier Party acting as factory
  factoryName    String? // free text when factory is not a party
  buyerId        String? // null + isInHouse = in-house production
  isInHouse      Boolean          @default(false)
  proformaId     String?
  /// The sales order it was started from ("Start production" on the order).
  salesOrderId   String?
  /// The master batch it is one style of (null: a project on its own).
  batchId        String?
  stage          ProductionStage  @default(FABRIC_SOURCING)
  status         ProductionStatus @default(ACTIVE)
  startDate      DateTime         @default(now())
  targetDate     DateTime
  completedAt    DateTime?
  targetQuantity Int
  producedQtyA   Int              @default(0)
  producedQtyB   Int              @default(0)
  totalCost      Decimal          @default(0) @db.Decimal(14, 2) // cached rollup
  /// The most a piece should cost ("Target price"); the cost guard compares the live
  /// cost per piece (cost so far ÷ pieces to make) with it. Null: no target set.
  targetUnitCost Decimal?         @db.Decimal(14, 2)
  /// The making charge (CM) per piece agreed with the factory; printed on the factory
  /// contract and the CM settlement. Null: not agreed yet.
  cmRate         Decimal?         @db.Decimal(14, 2)
  /// Milestones: cutting and sewing to be done by these days (warnings when they come
  /// near or pass). Null: not set.
  cutBy          DateTime?        @db.Date
  sewBy          DateTime?        @db.Date
  /// Making notes printed on the tech pack (written by hand, or drafted by AI and edited).
  techPackNotes  String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company              Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category             Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  style                Style?                   @relation(fields: [styleId], references: [id], onDelete: SetNull)
  factory              Party?                   @relation("ProductionFactory", fields: [factoryId], references: [id], onDelete: SetNull)
  buyer                Party?                   @relation("ProductionBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  proforma             ProformaInvoice?         @relation(fields: [proformaId], references: [id], onDelete: SetNull)
  salesOrder           SalesOrder?              @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  batch                ProductionBatch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  targetLines          ProductionTargetLine[]
  materialNeeds        ProductionMaterialNeed[]
  orderShares          PurchaseOrderLineShare[]
  faults               SupplierFault[]
  cuttingReports       CuttingReport[]
  embroideryJobs       EmbroideryJob[]
  finishingReports     FinishingReport[]
  stageLogs            ProductionStageLog[]
  billAllocations      SupplierBillAllocation[]
  expenses             Expense[]
  rawMaterialMovements RawMaterialMovement[]
  stockIntakes         StockIntake[]
  reminders            Reminder[]
  purchaseOrders       PurchaseOrder[]
  materialIssues       MaterialIssue[]
  materialChallans     MaterialChallan[]
  tasks                Task[]
  staffClaims          StaffClaim[]
  supplierPayments     Payment[]
  settlements          ProjectSettlement[]

  @@unique([companyId, code])
  @@index([companyId, status, targetDate])
  @@index([salesOrderId])
  @@index([batchId])
}

/// A master batch: one umbrella over the styles made together (e.g. 5,000 polo shirts
/// in several brands), usually at one factory by one day. Each style is a production
/// project of its own, with its colours and sizes, target price, costs and deliveries;
/// the batch adds them up. Its state follows its styles (none started: planned; all
/// closed: done).
model ProductionBatch {
  id                     String         @id @default(cuid())
  companyId              String
  code                   String // "MB-2026-00001"
  name                   String
  kind                   ProductionKind @default(CM)
  /// The factory its styles are made at; a new style starts with it.
  factoryId              String?
  /// The day it should all be done; a new style starts with it.
  targetDate             DateTime?
  /// Rejects (sewing faults, bodies ruined attaching accessories) up to this share of the
  /// pieces cut cost the factory nothing; each one over it is taken off the CM settlement
  /// at the style's target price.
  rejectTolerancePercent Decimal        @default(2) @db.Decimal(5, 2)
  notes                  String?
  createdById            String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  factory       Party?               @relation("BatchFactory", fields: [factoryId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("ProductionBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  projects      ProductionProject[]
  orders        PurchaseOrder[]
  contracts     ProductionContract[]
  faults        SupplierFault[]
  /// Advances paid for the batch (on the factory's CM).
  payments      Payment[]
  cmSettlements CmSettlement[]

  @@unique([companyId, code])
  @@index([companyId, createdAt])
}

/// An agreement drafted for a master batch with one of its suppliers or its factory:
/// the fabric, the accessories or the making (CM). Its clauses are drafted from the
/// batch (worded by AI when set up, plain rules otherwise), reviewed and changed, and
/// printed to sign. What it covers (the goods, or the styles and their CM) is always
/// printed from the batch as it is now.
model ProductionContract {
  id          String       @id @default(cuid())
  companyId   String
  batchId     String
  kind        ContractKind
  partyId     String
  number      String // "AGR-2026-00001"
  /// The clauses in order: [{ "title": "Delivery", "text": "..." }].
  clauses     Json
  /// The day both sides signed it (null: still a draft).
  signedOn    DateTime?    @db.Date
  createdById String?
  updatedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batch     ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  party     Party           @relation("ContractParty", fields: [partyId], references: [id])
  createdBy User?           @relation("ProductionContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("ProductionContractUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@unique([batchId, kind, partyId])
  @@index([companyId, batchId])
  @@index([partyId])
}

/// What one piece of a style takes of a raw material: a line of its bill of materials
/// ("Materials per piece"). The project's pieces turn it into what to order and issue.
model ProductionMaterialNeed {
  id             String        @id @default(cuid())
  companyId      String
  projectId      String
  rawMaterialId  String
  /// How much one piece takes, in the material's unit (0.25 kg, 1.8 m, 2 pcs).
  perPiece       Decimal       @db.Decimal(14, 4)
  /// Ordered on top for cutting loss and spoilage, as a percent.
  wastagePercent Decimal       @default(0) @db.Decimal(5, 2)
  /// How it is ordered: one total, per garment colour (fabric), or per colour and size (collars, cuffs).
  split          MaterialSplit @default(TOTAL)
  /// Where it goes on the garment ("Main body", "Collar", "Back neck label").
  placement      String?
  /// A sketch or photo for the supplier and the factory.
  imageId        String?
  notes          String?
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     ProductionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial       @relation(fields: [rawMaterialId], references: [id])
  image       FileAsset?        @relation("MaterialNeedImage", fields: [imageId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([rawMaterialId])
}

/// The pieces a project is to make of each SKU (a colour and size of a style): its
/// target grid, filled from the sales order or proforma it was started from, or by
/// hand. Optional: a project without one has only its total (targetQuantity), which
/// is the grid's sum when it has one.
model ProductionTargetLine {
  id        String @id @default(cuid())
  projectId String
  variantId String
  quantity  Int

  project ProductionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variant ProductVariant    @relation(fields: [variantId], references: [id])

  @@unique([projectId, variantId])
  @@index([variantId])
}

/// What a project owed one supplier when it was completed (closed): their bills for it,
/// what was paid on them and the rest, which stays due on the supplier's own ledger. A
/// statement only: nothing is posted, as every bill is already on that ledger, so the
/// project's balance with the supplier shows as zero from then on. Reopening the
/// project sets it aside; completing it again makes a new one.
model ProjectSettlement {
  id          String    @id @default(cuid())
  companyId   String
  projectId   String
  supplierId  String
  settledAt   DateTime  @default(now())
  billed      Decimal   @db.Decimal(14, 2) // the supplier's bills charged to the project
  paid        Decimal   @db.Decimal(14, 2) // paid on those bills when it closed
  carried     Decimal   @db.Decimal(14, 2) // still due, left on the supplier's ledger
  /// The bills as they stood: [{ id, number, billOn, charged, paid, due }].
  bills       Json
  settledById String?
  /// The project was reopened: this statement no longer stands.
  reopenedAt  DateTime?
  createdAt   DateTime  @default(now())

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   ProductionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier  Party             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  settledBy User?             @relation("SettlementMadeBy", fields: [settledById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([supplierId, settledAt])
}

/// History of stage badges (Fabric Sourcing -> Cutting -> Sewing -> Wash/QC -> Finishing).
model ProductionStageLog {
  id          String          @id @default(cuid())
  projectId   String
  stage       ProductionStage
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  note        String?

  project ProductionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A supplier bill (fabric, trims, factory CM...). Paid by Cash/Bank or left Due on
/// the supplier ledger, and split across one or more production batches.
model SupplierBill {
  id              String      @id @default(cuid())
  companyId       String
  number          String // internal number
  supplierRef     String? // supplier's own bill no
  supplierId      String
  billDate        DateTime    @default(now())
  totalAmount     Decimal     @db.Decimal(14, 2)
  paymentType     PaymentType
  paidAmount      Decimal     @default(0) @db.Decimal(14, 2)
  dueAmount       Decimal     @default(0) @db.Decimal(14, 2)
  status          BillStatus  @default(UNPAID)
  attachmentId    String?
  notes           String?
  journalEntryId  String?     @unique
  // Raw material purchases: the store the goods went into and the order they came on.
  warehouseId     String?
  purchaseOrderId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company              Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier             Party                    @relation(fields: [supplierId], references: [id])
  attachment           FileAsset?               @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  journalEntry         JournalEntry?            @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  warehouse            Warehouse?               @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  purchaseOrder        PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  allocations          SupplierBillAllocation[]
  items                SupplierBillItem[]
  payments             Payment[]
  rawMaterialMovements RawMaterialMovement[]
  purchaseReturns      PurchaseReturn[]
  faults               SupplierFault[]

  @@unique([companyId, number])
  @@index([supplierId])
  @@index([purchaseOrderId])
}

/// The supplier Fault Log: something a supplier or factory owes for (goods short against
/// the challan at receive, faulty fabric, missing pieces), with the value to deduct (null:
/// to agree). It stays open until it is deducted from what they are paid or waived.
model SupplierFault {
  id             String              @id @default(cuid())
  companyId      String
  number         String // "FLT-2026-00001"
  supplierId     String
  kind           SupplierFaultKind
  status         SupplierFaultStatus @default(OPEN)
  batchId        String?
  projectId      String?
  rawMaterialId  String?
  /// The receive (raw material bill) it was found on.
  billId         String?
  /// How much was short or faulty, in the material's unit (or pieces).
  quantity       Decimal?            @db.Decimal(14, 3)
  /// The value to deduct (null: still to agree).
  amount         Decimal?            @db.Decimal(14, 2)
  note           String?
  occurredOn     DateTime            @db.Date
  /// Deducted or waived: when, by whom and why.
  settledAt      DateTime?
  settledById    String?
  settledNote    String?
  /// A photo of the fault (the Fabric Fault Note's picture of the faulty roll).
  photoId        String?
  /// The final CM settlement it was taken off (marked deducted by it).
  cmSettlementId String?
  /// Taken off the supplier's Supplier Due by itself (pieces spoiled at an embroidery or
  /// print house): Dr Payable, Cr Deductions from Suppliers; reversed when reopened or waived.
  journalEntryId String?             @unique
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier     Party              @relation("SupplierFaults", fields: [supplierId], references: [id])
  photo        FileAsset?         @relation("SupplierFaultPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  batch        ProductionBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  project      ProductionProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  rawMaterial  RawMaterial?       @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)
  bill         SupplierBill?      @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("SupplierFaultCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  settledBy    User?              @relation("SupplierFaultSettledBy", fields: [settledById], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?      @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  /// The full packing list whose missing pieces it is for.
  packingLists FinishingReport[]  @relation("PackingListMissing")
  cmSettlement CmSettlement?      @relation(fields: [cmSettlementId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, status, occurredOn])
  @@index([supplierId, status])
  @@index([batchId])
  @@index([cmSettlementId])
  @@index([billId])
}

enum CuttingKind {
  CUT // pieces cut for the style
  REPLACEMENT // pieces cut again to replace ones spoiled outside (embroidery, print)
}

/// A cutting report: the pieces of a style cut on a day by colour and size, typed in or read
/// by AI from a photo of the cutting sheet, with the fabric used for them.
model CuttingReport {
  id              String      @id @default(cuid())
  companyId       String
  projectId       String
  number          String // "CUT-2026-00001"
  kind            CuttingKind @default(CUT)
  cutOn           DateTime    @db.Date
  /// [{ colorName, sizeName, quantity }]: null colour and size for a style without a grid.
  lines           Json
  /// [{ materialId, quantity }]: the fabric used for these pieces, in its unit.
  fabricUsed      Json        @default("[]")
  photoId         String?
  readByAi        Boolean     @default(false)
  /// The embroidery or print job whose spoiled pieces a replacement cut is for.
  embroideryJobId String?
  note            String?
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       ProductionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photo         FileAsset?        @relation("CuttingPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  embroideryJob EmbroideryJob?    @relation(fields: [embroideryJobId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("CuttingReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([projectId, cutOn])
}

enum FinishingKind {
  COUNT // pieces graded at finishing: A, B, C (mending) and rejects
  MENDING // C pieces back from mending as A, B or reject
  PACKING_LIST // the full packing list: A and B to stock, and what is missing
}

/// Finishing and QC at the factory, by colour and size: a count grading pieces A, B or C
/// (to mending) with rejects (sewing faults) kept apart; mended pieces coming back as A, B
/// or reject; and the full packing list, which moves the A and B pieces not yet in stock to
/// the Sales stock on one delivery and records what is missing (lost or stolen) in the
/// factory's fault log. C pieces, rejects and missing pieces never reach stock.
model FinishingReport {
  id          String        @id @default(cuid())
  companyId   String
  projectId   String
  number      String // "FIN-2026-00001"
  kind        FinishingKind @default(COUNT)
  countedOn   DateTime      @db.Date
  /// [{ colorName, sizeName, a, b, c, reject, missing }]: null colour and size for a style
  /// without a grid; c is negative on MENDING (pieces moved out of mending).
  lines       Json
  /// The packing list's delivery to stock (null when nothing new went to stock).
  intakeId    String?       @unique
  /// The packing list's missing pieces in the factory's fault log.
  faultId     String?
  /// A photo of the QC sheet or the factory's packing list.
  fileId      String?
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   ProductionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  intake    StockIntake?      @relation("PackingListDelivery", fields: [intakeId], references: [id], onDelete: SetNull)
  fault     SupplierFault?    @relation("PackingListMissing", fields: [faultId], references: [id], onDelete: SetNull)
  file      FileAsset?        @relation("FinishingFile", fields: [fileId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("FinishingReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([projectId, countedOn])
}

/// The final CM settlement of a master batch with its factory: the CM of each style's
/// pieces (A, B, C and rejects at its CM a piece), less the factory's open faults on the
/// batch (missing pieces, fabric faults...) and, when chosen, the CM of the C-grade pieces,
/// less the advance taken and what was paid for its styles: the final payable. Saving it
/// marks the faults it took off deducted; undoing it puts them back to open. It posts
/// nothing: the factory's bills and payments are already on their ledger.
model CmSettlement {
  id             String    @id @default(cuid())
  companyId      String
  batchId        String
  factoryId      String
  number         String // "CMS-2026-00001"
  settledOn      DateTime  @db.Date
  /// Whether the CM of the C-grade pieces was taken off (asked each time).
  deductCGrade   Boolean   @default(false)
  totalCm        Decimal   @db.Decimal(14, 2)
  deductions     Decimal   @db.Decimal(14, 2)
  /// Advances paid for the batch and payments for its styles, before it was settled.
  paid           Decimal   @db.Decimal(14, 2)
  payable        Decimal   @db.Decimal(14, 2)
  /// Everything printed: { styles, faults, cGrade, payments, ... } as it stood.
  snapshot       Json
  note           String?
  createdById    String?
  createdAt      DateTime  @default(now())
  /// Undone (by mistake, or to settle again): the faults it took off are open again.
  undoneAt       DateTime?
  undoneById     String?
  undoReason     String?
  /// The deductions taken off the factory's Supplier Due (Dr Payable, Cr Deductions from
  /// Suppliers); reversed when the settlement is undone. None when nothing was deducted.
  journalEntryId String?   @unique

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batch        ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  factory      Party           @relation("CmSettlementFactory", fields: [factoryId], references: [id])
  createdBy    User?           @relation("CmSettlementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  undoneBy     User?           @relation("CmSettlementUndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  faults       SupplierFault[]

  @@unique([companyId, number])
  @@index([batchId, createdAt])
  @@index([factoryId])
}

enum EmbroideryKind {
  EMBROIDERY
  PRINT
}

/// Cut pieces sent out for embroidery or print and what came back: good, and spoiled (to
/// replace from cutting at once).
model EmbroideryJob {
  id          String         @id @default(cuid())
  companyId   String
  projectId   String
  number      String // "EMB-2026-00001"
  kind        EmbroideryKind @default(EMBROIDERY)
  partyId     String?
  sentOn      DateTime       @db.Date
  /// When the pieces should be back.
  dueOn       DateTime?      @db.Date
  /// When the last pieces came back (null: some still out).
  receivedOn  DateTime?      @db.Date
  /// [{ colorName, sizeName, sent, received, spoiled }]
  lines       Json
  note        String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      ProductionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  party        Party?            @relation("EmbroideryParty", fields: [partyId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation("EmbroideryJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  replacements CuttingReport[]

  @@unique([companyId, number])
  @@index([projectId, sentOn])
}

/// Split Bill Logic: portion of a bill charged to a batch under an expense head.
model SupplierBillAllocation {
  id            String  @id @default(cuid())
  billId        String
  projectId     String? // null = general / raw-material stock
  expenseHeadId String
  amount        Decimal @db.Decimal(14, 2)
  description   String?

  bill        SupplierBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  project     ProductionProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  expenseHead ExpenseHead        @relation(fields: [expenseHeadId], references: [id])

  @@index([projectId])
}

/// "Move to Stock": factory packing list photo/PDF parsed by AI (or entered manually),
/// allocating batch cost across A-Grade and B-Grade quantities. A confirmed
/// delivery entered by mistake is undone (REVERSED): its pieces leave stock and
/// its cost goes back to the project; a corrected copy can start as a new draft.
model StockIntake {
  id              String               @id @default(cuid())
  companyId       String
  number          String
  projectId       String?
  warehouseId     String? // where the goods are received
  sourceFileId    String?
  method          IntakeMethod         @default(MANUAL)
  status          IntakeStatus         @default(DRAFT)
  aiRawResult     Json? // OCR output before human confirmation
  aiConfidence    Decimal?             @db.Decimal(5, 2)
  totalCost       Decimal              @default(0) @db.Decimal(14, 2)
  costAllocation  CostAllocationMethod @default(EQUAL_PER_PIECE)
  bGradeCostRatio Decimal?             @db.Decimal(5, 4) // e.g. 0.5 = B-Grade valued at 50%
  notes           String?
  confirmedAt     DateTime?
  reversedAt      DateTime?
  reversedById    String?
  reversalReason  String?
  /// The undone delivery this draft was copied from to correct it.
  correctionOfId  String?
  createdAt       DateTime             @default(now())

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      ProductionProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  warehouse    Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  sourceFile   FileAsset?         @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  reversedBy   User?              @relation("IntakeReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  correctionOf StockIntake?       @relation("IntakeCorrection", fields: [correctionOfId], references: [id], onDelete: SetNull)
  corrections  StockIntake[]      @relation("IntakeCorrection")
  lines        StockIntakeLine[]
  lots         StockLot[]
  /// The full packing list that made this delivery (Finishing).
  packingList  FinishingReport?   @relation("PackingListDelivery")

  @@unique([companyId, number])
  @@index([projectId])
  @@index([correctionOfId])
}

model StockIntakeLine {
  id             String     @id @default(cuid())
  intakeId       String
  variantId      String
  grade          StockGrade
  quantity       Int
  unitCost       Decimal    @db.Decimal(14, 4)
  /// Value added to (or taken from) the line's pieces when its project was completed and
  /// every piece received was evened out to the same cost; 0 until then, and again if reopened.
  costAdjustment Decimal    @default(0) @db.Decimal(14, 4)

  intake  StockIntake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([intakeId, variantId, grade])
}

// =============================================================================
// 8. ACCOUNTS & FINANCE
// =============================================================================

/// Chart of accounts. `subType` lets dashboards find Cash, Bank, Receivables,
/// Payables, Fixed Assets, Loans, Investors, Inventory, COGS, etc.
model LedgerAccount {
  id             String         @id @default(cuid())
  companyId      String
  code           String
  name           String
  type           AccountType
  subType        AccountSubType
  parentId       String?
  isSystem       Boolean        @default(false)
  isActive       Boolean        @default(true)
  openingBalance Decimal        @default(0) @db.Decimal(14, 2)
  createdAt      DateTime       @default(now())

  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent         LedgerAccount?       @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       LedgerAccount[]      @relation("AccountTree")
  lines          JournalLine[]
  payments       Payment[]
  refunds        Refund[]
  bankAccount    BankAccount?
  fixedAsset     FixedAsset?
  capitalSource  CapitalSource?
  pettyCashBox   PettyCashBox?
  expenseHeads   ExpenseHead[]
  expensesPaid   Expense[]            @relation("ExpensePaidFrom")
  salaryAdvances SalaryAdvance[]
  salaryPayments PayrollPayment[]
  installments   CapitalInstallment[]

  @@unique([companyId, code])
  @@index([companyId, type, subType])
}

/// A balanced double-entry voucher. Every financial module posts here.
model JournalEntry {
  id           String        @id @default(cuid())
  companyId    String
  number       String
  date         DateTime      @default(now())
  description  String?
  sourceType   JournalSource
  sourceId     String?
  postedById   String?
  isReversed   Boolean       @default(false)
  reversalOfId String?       @unique
  createdAt    DateTime      @default(now())

  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedBy          User?                 @relation("JournalPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reversalOf        JournalEntry?         @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy        JournalEntry?         @relation("JournalReversal")
  lines             JournalLine[]
  payment           Payment?
  refund            Refund?
  salesReturn       SalesReturn?
  supplierBill      SupplierBill?
  expense           Expense?
  badStock          BadStockEntry?
  payrollRun        PayrollRun?           @relation("PayrollAccrual")
  payrollPayment    PayrollPayment?
  salaryAdvance     SalaryAdvance?
  advanceSettlement AdvanceSettlement?
  materialIssue     MaterialIssue?
  purchaseReturn    PurchaseReturn?
  materialMovements RawMaterialMovement[]
  claimPayments     StaffClaim[]
  cmSettlement      CmSettlement?
  supplierFault     SupplierFault?

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([sourceType, sourceId])
}

/// Debit/credit line. `partyId` builds each buyer's/supplier's lifetime ledger.
model JournalLine {
  id          String    @id @default(cuid())
  entryId     String
  accountId   String
  partyId     String?
  employeeId  String?
  debit       Decimal   @default(0) @db.Decimal(14, 2)
  credit      Decimal   @default(0) @db.Decimal(14, 2)
  memo        String?
  /// Bank reconcile: when the line was ticked as matching the real bank statement, and by
  /// whom. Empty until then; it never changes the amounts or the entry.
  clearedAt   DateTime?
  clearedById String?

  entry     JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  party     Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  employee  Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  clearedBy User?         @relation("JournalLineClearedBy", fields: [clearedById], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([partyId])
  @@index([employeeId])
}

/// Bank accounts (each mapped to a ledger account) for bank-compliant statements.
model BankAccount {
  id              String   @id @default(cuid())
  companyId       String
  ledgerAccountId String   @unique
  bankName        String
  branch          String?
  accountName     String
  accountNumber   String
  routingNumber   String?
  swiftCode       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount     @relation(fields: [ledgerAccountId], references: [id])
  proformas     ProformaInvoice[]

  @@unique([companyId, accountNumber])
}

/// A petty cash box: cash one person holds for small daily costs, on its own cash
/// ledger account so the main cash and bank ledgers stay clean. Accounts tops it up
/// (a transfer into its account); the holder records each cost from it straight into
/// the books, with no approval step, up to what is in the box.
model PettyCashBox {
  id              String   @id @default(cuid())
  companyId       String
  ledgerAccountId String   @unique
  name            String
  holderId        String
  /// The amount it is usually topped up to: a guide, not a limit.
  float           Decimal? @db.Decimal(14, 2)
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  holder        User          @relation("PettyCashHolder", fields: [holderId], references: [id])

  @@unique([companyId, name])
  @@index([holderId])
}

/// Fixed asset register. Cost sits on the Fixed Assets account and depreciation on
/// Accumulated Depreciation; journal entries name the asset in `sourceId`.
model FixedAsset {
  id                 String             @id @default(cuid())
  companyId          String
  ledgerAccountId    String?            @unique
  name               String
  category           String? // Machinery, Furniture, Vehicle, IT...
  purchaseDate       DateTime
  purchaseCost       Decimal            @db.Decimal(14, 2)
  depreciationRate   Decimal?           @db.Decimal(5, 2) // % per year
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  salvageValue       Decimal            @default(0) @db.Decimal(14, 2) // book value never goes below this
  currentValue       Decimal            @db.Decimal(14, 2) // book value: cost - depreciation so far
  depreciatedUntil   DateTime?          @db.Date // last calendar day depreciation was posted for
  location           String?
  status             AssetStatus        @default(IN_USE)
  disposedAt         DateTime?
  disposalAmount     Decimal?           @db.Decimal(14, 2) // sale proceeds (0 when scrapped)
  notes              String?
  createdAt          DateTime           @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount? @relation(fields: [ledgerAccountId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
}

/// Capital, investors and loans (liabilities) with installment schedules.
model CapitalSource {
  id              String            @id @default(cuid())
  companyId       String
  ledgerAccountId String?           @unique
  kind            CapitalSourceKind
  name            String // investor / lender name
  contact         String?
  principal       Decimal           @db.Decimal(14, 2)
  interestRate    Decimal?          @db.Decimal(5, 2)
  profitSharePct  Decimal?          @db.Decimal(5, 2)
  startDate       DateTime
  maturityDate    DateTime?
  outstanding     Decimal           @db.Decimal(14, 2)
  status          CapitalStatus     @default(ACTIVE)
  notes           String?
  createdAt       DateTime          @default(now())

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount?       @relation(fields: [ledgerAccountId], references: [id], onDelete: SetNull)
  installments  CapitalInstallment[]
}

/// Scheduled installment payouts (loan EMIs, investor profit payouts).
model CapitalInstallment {
  id                String            @id @default(cuid())
  capitalSourceId   String
  dueDate           DateTime
  amount            Decimal           @db.Decimal(14, 2)
  principalPart     Decimal?          @db.Decimal(14, 2)
  interestPart      Decimal?          @db.Decimal(14, 2)
  status            InstallmentStatus @default(SCHEDULED)
  paidAt            DateTime?
  paidFromAccountId String?
  journalEntryId    String?
  note              String?

  capitalSource   CapitalSource  @relation(fields: [capitalSourceId], references: [id], onDelete: Cascade)
  paidFromAccount LedgerAccount? @relation(fields: [paidFromAccountId], references: [id], onDelete: SetNull)

  @@index([capitalSourceId, dueDate])
}

// =============================================================================
// 9. EXPENSES & MARKETING
// =============================================================================

model ExpenseHead {
  id               String          @id @default(cuid())
  companyId        String
  name             String
  category         ExpenseCategory
  ledgerAccountId  String?
  isProductionCost Boolean         @default(false)
  requiresEmployee Boolean         @default(false) // true for Conveyance / Food
  isActive         Boolean         @default(true)

  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount?           @relation(fields: [ledgerAccountId], references: [id], onDelete: SetNull)
  expenses        Expense[]
  billAllocations SupplierBillAllocation[]
  staffClaims     StaffClaim[]             @relation("StaffClaimCostHead")

  @@unique([companyId, name])
}

/// General expense (incl. Quick Add). Conveyance/Food entries must name an
/// employee and purpose; when paid they settle the employee's open advances
/// first (see AdvanceSettlement).
model Expense {
  id                String      @id @default(cuid())
  companyId         String
  number            String
  date              DateTime    @default(now())
  headId            String
  amount            Decimal     @db.Decimal(14, 2)
  paymentType       PaymentType
  paidFromAccountId String? // Cash/Bank account when paymentType = CASH_BANK
  supplierId        String? // supplier ledger when paymentType = DUE
  projectId         String? // production batch cost
  employeeId        String? // required for conveyance/food
  purpose           String?
  fromLocation      String?
  toLocation        String?
  description       String?
  receiptFileId     String?
  formPrinted       Boolean     @default(false)
  journalEntryId    String?     @unique
  voidedAt          DateTime? // voided entries stay for the record; their journal is reversed
  voidReason        String?
  createdById       String? // who recorded it (claims are paid back to them)
  createdAt         DateTime    @default(now())

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  head               ExpenseHead         @relation(fields: [headId], references: [id])
  paidFromAccount    LedgerAccount?      @relation("ExpensePaidFrom", fields: [paidFromAccountId], references: [id], onDelete: SetNull)
  supplier           Party?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  project            ProductionProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employee           Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  receiptFile        FileAsset?          @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)
  journalEntry       JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  advanceSettlements AdvanceSettlement[]
  staffClaim         StaffClaim?

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([employeeId])
  @@index([projectId])
  @@index([createdById])
}

/// Daily ad spend for the ROAS widget (Ad Spend vs Retail Sales).
model AdSpend {
  id        String     @id @default(cuid())
  companyId String
  date      DateTime   @db.Date
  platform  AdPlatform
  campaign  String?
  amount    Decimal    @db.Decimal(14, 2)
  createdAt DateTime   @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
}

// =============================================================================
// 10. HR, PAYROLL, LEAVE, ADVANCES
// =============================================================================

/// A person on the payroll. `baseSalary` is the monthly gross salary in force
/// now; SalaryRevision keeps the history payroll reads month by month.
model Employee {
  id                String         @id @default(cuid())
  companyId         String
  userId            String? // links to login for the Employee Portal
  code              String
  name              String
  designation       String?
  department        String?
  phone             String?
  whatsapp          String?
  email             String?
  nid               String?
  address           String?
  photoUrl          String?
  dateOfBirth       DateTime?      @db.Date
  bloodGroup        String?
  emergencyContact  String?
  joinDate          DateTime       @db.Date
  exitDate          DateTime?      @db.Date // last working day
  exitReason        String?
  baseSalary        Decimal        @db.Decimal(14, 2)
  overtimeRate      Decimal?       @db.Decimal(10, 2) // per overtime hour
  salaryMethod      PaymentMethod  @default(CASH) // how the salary is usually paid
  bankName          String?
  bankAccountNumber String?
  bankBranch        String?
  walletNumber      String? // bKash / Nagad / Rocket number
  /// Someone who knows them and can vouch for them (not the emergency contact).
  referenceName     String?
  referencePhone    String?
  referenceRelation String?
  notes             String?
  status            EmployeeStatus @default(ACTIVE)
  /// When they last agreed to the terms of employment (TermsAcceptance).
  termsAgreedAt     DateTime?
  /// Where they normally check in; check-ins away from it are flagged.
  workLocationId    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  salaryHistory   SalaryRevision[]
  attendance      Attendance[]
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[]
  payrollItems    PayrollItem[]
  advances        SalaryAdvance[]
  expenses        Expense[]
  journalLines    JournalLine[]
  tasksAssigned   Task[]              @relation("TaskAssignee")
  reminderTargets ReminderRecipient[]
  notifications   NotificationLog[]
  packedOrders    SalesOrder[]        @relation("OrderPackedBy")
  payRequests     PayDetailsRequest[]
  documents       EmployeeDocument[]
  termsAgreed     TermsAcceptance[]
  workLocation    WorkLocation?       @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  locationPings   LocationPing[]
  position        StaffPosition?
  overtimeEntries OvertimeEntry[]
  staffClaims     StaffClaim[]
  assets          EmployeeAsset[]

  @@unique([companyId, code])
  @@unique([companyId, userId])
  @@index([workLocationId])
}

/// An employee's ask (from My HR) to be paid another way or to another account.
/// HR approves it before the pay details change, so salaries cannot be redirected
/// by whoever holds the login. One waits at a time per employee.
model PayDetailsRequest {
  id            String           @id @default(cuid())
  companyId     String
  employeeId    String
  /// The asked-for pay details: { salaryMethod, bankName, bankBranch, bankAccountNumber, walletNumber }.
  changes       Json
  /// The pay details when it was asked, to show what changes.
  previous      Json
  note          String?
  status        PayRequestStatus @default(PENDING)
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  /// Why it was turned down (or a note on the approval).
  decisionNote  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy User?    @relation("PayDetailsRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?    @relation("PayDetailsDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([employeeId, createdAt])
}

/// A paper kept in an employee's data vault: an NID scan, a photo, a certificate.
/// The file opens to HR (hr.manage) and to the employee.
model EmployeeDocument {
  id         String               @id @default(cuid())
  companyId  String
  employeeId String
  kind       EmployeeDocumentKind
  title      String?
  fileId     String
  addedById  String?
  createdAt  DateTime             @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  file            FileAsset        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  addedBy         User?            @relation("EmployeeDocumentAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  termsAcceptance TermsAcceptance?

  @@index([employeeId, kind, createdAt])
  @@index([fileId])
}

/// A version of the company's terms of employment. HR edits a draft (version
/// null); publishing numbers it, and a published version never changes.
model TermsVersion {
  id            String    @id @default(cuid())
  companyId     String
  /// 1, 2, 3... once published; null while a draft.
  version       Int?
  title         String
  intro         String?
  /// [{ title, body }], in order.
  sections      Json
  /// On publishing: true when everyone must agree again, false when only staff
  /// who have not agreed to any version yet must.
  askEveryone   Boolean   @default(true)
  /// SHA-256 of the published text, printed on every signed copy.
  textHash      String?
  publishedAt   DateTime?
  publishedById String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publishedBy User?             @relation("TermsVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("TermsVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  acceptances TermsAcceptance[]

  @@unique([companyId, version])
  @@index([companyId, publishedAt])
}

/// An employee's agreement to a version of the terms, with what shows it was
/// them: the drawn signature or the SMS code's number, the IP address and device,
/// and their name and NID at that moment. The signed PDF is made in the background.
model TermsAcceptance {
  id            String          @id @default(cuid())
  companyId     String
  employeeId    String
  versionId     String
  userId        String?
  method        TermsSignMethod
  /// The drawn signature (PNG), when signed by hand.
  signature     Bytes?
  /// The number the SMS code went to, when agreed by code.
  phone         String?
  nameAtSigning String
  codeAtSigning String
  nidAtSigning  String?
  ipAddress     String?
  userAgent     String?
  textHash      String
  signedAt      DateTime        @default(now())
  /// The signed PDF in the employee's papers, once made.
  documentId    String?         @unique

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  version  TermsVersion      @relation(fields: [versionId], references: [id], onDelete: NoAction)
  user     User?             @relation("TermsAcceptedBy", fields: [userId], references: [id], onDelete: SetNull)
  document EmployeeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([employeeId, versionId])
  @@index([companyId, versionId])
}

/// A one-time code sent by SMS to confirm something (agreeing to the terms).
/// Only a hash of the code is kept.
model OneTimeCode {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  /// What the code confirms, like "terms:<versionId>".
  purpose   String
  codeHash  String
  sentTo    String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

/// Work the app does in the background (jobs/queue.ts), like making a signed
/// PDF. A worker inside the app claims each job once, retries a failure a few
/// times with a growing wait, and picks up a job a crashed run left behind.
model BackgroundJob {
  id          String    @id @default(cuid())
  companyId   String?
  /// What to do, like "terms.pdf" (jobs/handlers.ts).
  kind        String
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([companyId, kind, createdAt])
}

/// Monthly gross salary from a day onwards (the first one is the joining salary).
model SalaryRevision {
  id            String   @id @default(cuid())
  employeeId    String
  effectiveFrom DateTime @db.Date
  amount        Decimal  @db.Decimal(14, 2)
  reason        String?
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
}

/// Per-company HR rules used by attendance, leave and payroll.
model HrSettings {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  weeklyOffDays        Int[]    @default([5]) // 0 = Sunday ... 6 = Saturday (5 = Friday)
  officeStartTime      String   @default("09:00") // check-ins after this plus the grace are late
  lateGraceMinutes     Int      @default(15)
  latesPerDeductionDay Int      @default(0) // e.g. 3: every 3 lates cost a day's salary; 0 = never
  selfCheckIn          Boolean  @default(true) // employees may check in from the portal
  /// Staff share their location when they check in and out and while checked in.
  gpsAttendance        Boolean  @default(false)
  /// When the working day ends: staying later than this is overtime.
  officeEndTime        String   @default("18:00")
  /// Shadow overtime: the app finds overtime from self check-outs for HR to
  /// approve (staff never see it), once someone stays at least this long.
  shadowOvertime       Boolean  @default(true)
  overtimeMinMinutes   Int      @default(30)
  /// The usual conveyance fare for a kilometre: a claim more than half again
  /// the usual fare for the distance is flagged (0 turns that check off).
  conveyanceRatePerKm  Decimal  @default(30) @db.Decimal(10, 2)
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Public and company holidays: paid days off, not counted as working days.
model Holiday {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
}

/// One employee's attendance on one day. Working days without a row count as
/// present, so only lates, half days, absences (and overtime) need marking;
/// self check-ins from the portal also land here.
model Attendance {
  id               String           @id @default(cuid())
  companyId        String
  employeeId       String
  date             DateTime         @db.Date
  status           AttendanceStatus
  checkIn          DateTime?
  checkOut         DateTime?
  overtimeMinutes  Int              @default(0)
  note             String?
  source           AttendanceSource @default(MANUAL)
  recordedById     String?
  /// Where the phone was at check-in (self check-ins with location on).
  checkInLat       Float?
  checkInLng       Float?
  checkInAccuracy  Float? // metres
  checkInIp        String?
  /// The work place it was compared with, how far away it was, and whether
  /// that is outside the place's radius ("Location mismatch").
  checkInPlaceId   String?
  checkInDistance  Int? // metres
  checkInAway      Boolean          @default(false)
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  checkOutIp       String?
  checkOutPlaceId  String?
  checkOutDistance Int?
  checkOutAway     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy    User?          @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  checkInPlace  WorkLocation?  @relation("AttendanceCheckInPlace", fields: [checkInPlaceId], references: [id], onDelete: SetNull)
  checkOutPlace WorkLocation?  @relation("AttendanceCheckOutPlace", fields: [checkOutPlaceId], references: [id], onDelete: SetNull)
  overtime      OvertimeEntry?

  @@unique([employeeId, date])
  @@index([companyId, date])
}

/// Overtime the app found from a self check-out ("shadow overtime"). The
/// employee never sees it. HR approves it as found, changes it with a reason,
/// or rejects it; only approved minutes go on the day's attendance
/// (Attendance.overtimeMinutes), which payroll already pays.
model OvertimeEntry {
  id               String         @id @default(cuid())
  companyId        String
  employeeId       String
  attendanceId     String         @unique
  date             DateTime       @db.Date
  basis            OvertimeBasis
  /// When overtime started counting: the end of the working day, or the
  /// check-in on a day off.
  startsAt         DateTime
  checkOut         DateTime
  detectedMinutes  Int
  /// The location trail's view: overtime only up to the last position at the
  /// work place, when the person left before checking out.
  suggestedMinutes Int?
  lastAtPlace      DateTime?
  status           OvertimeStatus @default(PENDING)
  approvedMinutes  Int?
  /// Why HR changed or rejected it (required then).
  reason           String?
  decidedById      String?
  decidedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  decidedBy  User?      @relation("OvertimeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, date])
  @@index([employeeId, date])
}

/// Money an employee spent for the company and claims back from My HR:
/// conveyance (checked against their GPS trail and the usual fare) or local
/// material bought for a production project. Accounts approves it: the cost
/// goes into the books (a conveyance expense, or a cost on the project) and
/// the amount is owed to the employee until Accounts pays it back.
model StaffClaim {
  id             String           @id @default(cuid())
  companyId      String
  employeeId     String
  number         String
  kind           StaffClaimKind
  /// The day of the trip or the purchase.
  date           DateTime         @db.Date
  amount         Decimal          @db.Decimal(14, 2)
  purpose        String?
  /// Conveyance: where the trip started and ended, and the two in a form that
  /// matches other claims for the same route (either way round).
  fromPlace      String?
  toPlace        String?
  routeKey       String?
  /// Local material: the production project it was bought for, what was
  /// bought, how much and where.
  projectId      String?
  item           String?
  quantity       String?
  shop           String?
  receiptFileId  String?
  /// What the checks found, for Accounts and HR (never shown to the employee).
  flags          StaffClaimFlag[]
  check          Json?
  checkedAt      DateTime?
  /// Google Maps, when connected: the road distance and where the two ends are.
  roadMetres     Int?
  fromLat        Float?
  fromLng        Float?
  toLat          Float?
  toLng          Float?
  roadCheckedAt  DateTime?
  status         StaffClaimStatus @default(PENDING)
  approvedAmount Decimal?         @db.Decimal(14, 2)
  /// Why the amount was cut, or why it was rejected or withdrawn.
  reason         String?
  decidedById    String?
  decidedAt      DateTime?
  /// The expense the approval put in the books (for local material, the cost
  /// on the project) and the production cost head it went under.
  expenseId      String?          @unique
  costHeadId     String?
  /// Paid back by Accounts, on its own or with a salary.
  paidAt         DateTime?
  paidById       String?
  paymentEntryId String?
  /// The salary line it is paid back with, once that payroll is approved.
  payrollItemId  String?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project      ProductionProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  receiptFile  FileAsset?         @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)
  expense      Expense?           @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  costHead     ExpenseHead?       @relation("StaffClaimCostHead", fields: [costHeadId], references: [id], onDelete: SetNull)
  decidedBy    User?              @relation("StaffClaimDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  paidBy       User?              @relation("StaffClaimPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("StaffClaimCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  paymentEntry JournalEntry?      @relation(fields: [paymentEntryId], references: [id], onDelete: SetNull)
  payrollItem  PayrollItem?       @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, status, date])
  @@index([employeeId, date])
  @@index([companyId, routeKey])
  @@index([projectId])
  @@index([payrollItemId])
}

/// A notice on the staff notice board (My HR > Notices), posted by HR for
/// every employee: shown until its last day or until it is taken down.
model Notice {
  id            String    @id @default(cuid())
  companyId     String
  title         String
  body          String
  /// Kept at the top of the board.
  pinned        Boolean   @default(false)
  /// The last day staff see it (none: until it is taken down).
  showUntil     DateTime? @db.Date
  /// Changed after it was posted.
  editedAt      DateTime?
  /// Taken down by HR: staff no longer see it.
  takenDownAt   DateTime?
  takenDownById String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("NoticeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  takenDownBy User?        @relation("NoticeTakenDownBy", fields: [takenDownById], references: [id], onDelete: SetNull)
  reads       NoticeRead[]

  @@index([companyId, takenDownAt, createdAt])
}

/// Who has read a notice, and when (the first time they saw it on the board).
model NoticeRead {
  id        String   @id @default(cuid())
  companyId String
  noticeId  String
  userId    String
  readAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notice  Notice  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([companyId, userId])
}

/// A company item in an employee's hands (a laptop, phone, SIM, ID card, keys,
/// uniform, tools): given on a day and returned (good, damaged or lost). Items
/// not returned hold up the clearance when the person leaves.
model EmployeeAsset {
  id              String       @id @default(cuid())
  companyId       String
  employeeId      String
  name            String
  kind            AssetKind    @default(OTHER)
  /// Serial number, asset tag or SIM number.
  tag             String?
  /// What it is worth, for a lost item.
  value           Decimal?     @db.Decimal(14, 2)
  issuedOn        DateTime     @db.Date
  issueNote       String?
  issuedById      String?
  returnedOn      DateTime?    @db.Date
  returnCondition AssetReturn?
  returnNote      String?
  returnedToId    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy   User?    @relation("EmployeeAssetIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  returnedTo User?    @relation("EmployeeAssetReturnedTo", fields: [returnedToId], references: [id], onDelete: SetNull)

  @@index([companyId, returnedOn])
  @@index([employeeId, returnedOn])
}

/// A place staff check in at (an office, a factory floor, a shop), with the
/// radius inside which a check-in counts as being there.
model WorkLocation {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  address      String?
  lat          Float
  lng          Float
  radiusMeters Int      @default(150)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  checkIns  Attendance[] @relation("AttendanceCheckInPlace")
  checkOuts Attendance[] @relation("AttendanceCheckOutPlace")

  @@unique([companyId, name])
}

/// A position a checked-in employee's phone sent while on duty (from My HR in
/// the browser, or the Android app in the background). Kept for 90 days.
model LocationPing {
  id         BigInt     @id @default(autoincrement())
  companyId  String
  employeeId String
  at         DateTime // when the phone took the position
  lat        Float
  lng        Float
  accuracy   Float? // metres
  speed      Float? // metres a second
  battery    Int? // per cent
  source     PingSource @default(WEB)
  createdAt  DateTime   @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, at])
  @@index([companyId, at])
}

/// Each employee's latest position, one row per person, so the live staff map
/// reads a few rows instead of every ping.
model StaffPosition {
  employeeId String     @id
  companyId  String
  at         DateTime
  lat        Float
  lng        Float
  accuracy   Float?
  battery    Int?
  source     PingSource @default(WEB)
  updatedAt  DateTime   @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model LeaveType {
  id          String  @id @default(cuid())
  companyId   String
  name        String // Casual, Sick, Annual...
  daysPerYear Int
  isPaid      Boolean @default(true)
  prorate     Boolean @default(true) // joiners get a share for the months they work that year
  isActive    Boolean @default(true)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, name])
}

/// Leave entitled and taken per calendar year. `used` follows the approved
/// requests; `adjusted` keeps an entitlement HR set by hand (e.g. carried over).
model LeaveBalance {
  id          String  @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  entitled    Decimal @db.Decimal(5, 1)
  used        Decimal @default(0) @db.Decimal(5, 1)
  adjusted    Boolean @default(false)
  note        String?

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
}

/// `days` counts working days only (weekly days off and holidays are skipped).
model LeaveRequest {
  id            String      @id @default(cuid())
  companyId     String
  employeeId    String
  leaveTypeId   String
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  halfDay       Boolean     @default(false) // only for a single day
  days          Decimal     @db.Decimal(5, 1)
  reason        String?
  status        LeaveStatus @default(PENDING)
  requestedById String?
  approvedById  String? // who approved or rejected it
  decidedAt     DateTime?
  decisionNote  String?
  attachmentId  String?
  createdAt     DateTime    @default(now())

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType  @relation(fields: [leaveTypeId], references: [id])
  requestedBy User?      @relation("LeaveRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?      @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  attachment  FileAsset? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([employeeId, startDate])
  @@index([companyId, status])
}

/// Monthly payroll batch. Approving it posts the month's salaries to the books
/// (`journalEntryId`); paying it posts PayrollPayment vouchers.
model PayrollRun {
  id             String        @id @default(cuid())
  companyId      String
  year           Int
  month          Int // 1-12
  status         PayrollStatus @default(DRAFT)
  totalGross     Decimal       @default(0) @db.Decimal(14, 2)
  totalNet       Decimal       @default(0) @db.Decimal(14, 2)
  journalEntryId String?       @unique
  notes          String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry?    @relation("PayrollAccrual", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("PayrollCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?            @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items        PayrollItem[]
  payments     PayrollPayment[]

  @@unique([companyId, year, month])
}

/// One employee's salary for one month (the payslip). Day counts come from
/// attendance and leave; `overtimeEdited` / `advanceEdited` mark figures typed
/// in by hand, which a recalculation keeps.
model PayrollItem {
  id                   String  @id @default(cuid())
  runId                String
  employeeId           String
  monthlySalary        Decimal @default(0) @db.Decimal(14, 2) // gross monthly salary in force
  workingDays          Int     @default(0)
  presentDays          Decimal @default(0) @db.Decimal(5, 1)
  paidLeaveDays        Decimal @default(0) @db.Decimal(5, 1)
  unpaidLeaveDays      Decimal @default(0) @db.Decimal(5, 1)
  absentDays           Decimal @default(0) @db.Decimal(5, 1)
  lateDays             Int     @default(0)
  unpaidDays           Decimal @default(0) @db.Decimal(5, 1) // absent + unpaid leave + late penalty
  overtimeHours        Decimal @default(0) @db.Decimal(6, 2)
  overtimeEdited       Boolean @default(false)
  basic                Decimal @db.Decimal(14, 2) // salary for the days employed this month
  allowances           Decimal @default(0) @db.Decimal(14, 2)
  overtime             Decimal @default(0) @db.Decimal(14, 2)
  bonus                Decimal @default(0) @db.Decimal(14, 2)
  unpaidLeaveDeduction Decimal @default(0) @db.Decimal(14, 2)
  advanceDeduction     Decimal @default(0) @db.Decimal(14, 2)
  advanceEdited        Boolean @default(false)
  taxDeduction         Decimal @default(0) @db.Decimal(14, 2)
  otherDeductions      Decimal @default(0) @db.Decimal(14, 2)
  /// Why the other deductions were taken (a fine, a loss): needed whenever
  /// they are more than zero, shown on the payslip.
  deductionReason      String?
  /// Approved staff claims paid back with this salary (not salary: no tax, not
  /// a salary cost). Take-home = gross pay + reimbursements - deductions.
  reimbursements       Decimal @default(0) @db.Decimal(14, 2)
  netPay               Decimal @db.Decimal(14, 2)
  note                 String?
  /// Paid so far by live salary payments; a salary can be paid in parts.
  paidAmount           Decimal @default(0) @db.Decimal(14, 2)
  /// The payment that finished paying the line (null until it is paid in full).
  paymentId            String?

  run          PayrollRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payment      PayrollPayment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  settlements  AdvanceSettlement[]
  paymentLines PayrollPaymentLine[]
  claims       StaffClaim[]

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([paymentId])
}

/// Salaries paid for a payroll run: one payment voucher per batch (cash, a bank
/// transfer...) covering one or more employees. Voided payments stay for the
/// record; their entry is reversed and their employees are unpaid again.
model PayrollPayment {
  id             String        @id @default(cuid())
  companyId      String
  runId          String
  number         String
  date           DateTime
  method         PaymentMethod
  accountId      String // cash / bank / wallet account paid from
  amount         Decimal       @db.Decimal(14, 2)
  employeeCount  Int
  reference      String?
  journalEntryId String?       @unique
  paidById       String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime      @default(now())

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run          PayrollRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  account      LedgerAccount        @relation(fields: [accountId], references: [id])
  journalEntry JournalEntry?        @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  paidBy       User?                @relation("PayrollPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  items        PayrollItem[]
  lines        PayrollPaymentLine[]

  @@unique([companyId, number])
  @@index([runId])
}

/// How much of one employee's salary a payment paid (all of it, or a part).
/// When paid through the wallet plug (bKash, Nagad, Rocket), the payout's state
/// is kept here; null means Accounts handed the money over themselves.
model PayrollPaymentLine {
  id              String       @id @default(cuid())
  companyId       String
  paymentId       String
  itemId          String
  amount          Decimal      @db.Decimal(14, 2)
  payout          PayoutState?
  payoutReference String?
  payoutError     String?
  payoutAt        DateTime?

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment PayrollPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  item    PayrollItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([itemId])
}

/// Cash advance given to an employee (or brought forward at go-live). It is
/// recovered from salary (in installments when set), settled by conveyance and
/// food expenses, or returned in cash.
model SalaryAdvance {
  id                String        @id @default(cuid())
  companyId         String
  employeeId        String
  number            String
  amount            Decimal       @db.Decimal(14, 2)
  outstanding       Decimal       @db.Decimal(14, 2)
  givenAt           DateTime      @default(now())
  method            PaymentMethod @default(CASH)
  paidFromAccountId String?
  reference         String?
  purpose           String?
  installmentAmount Decimal?      @db.Decimal(14, 2) // recovered per salary; null = all at once
  recoverFrom       DateTime?     @db.Date // first payroll month to recover in (default: the month given)
  isOpening         Boolean       @default(false) // owed from before the ERP
  status            AdvanceStatus @default(OPEN)
  journalEntryId    String?       @unique
  createdById       String?
  voidedAt          DateTime?
  voidReason        String?
  createdAt         DateTime      @default(now())

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  paidFromAccount LedgerAccount?      @relation(fields: [paidFromAccountId], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy       User?               @relation("AdvanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  settlements     AdvanceSettlement[]

  @@unique([companyId, number])
  @@index([employeeId, status])
}

/// Part of an advance recovered from a salary, settled by an expense, or
/// returned in cash. Reversed settlements (a voided expense, a reopened payroll)
/// stay for the record with `reversedAt` set.
model AdvanceSettlement {
  id             String                @id @default(cuid())
  advanceId      String
  kind           AdvanceSettlementKind
  payrollItemId  String?
  expenseId      String?
  journalEntryId String?               @unique // cash returns post their own entry
  amount         Decimal               @db.Decimal(14, 2)
  settledAt      DateTime              @default(now())
  note           String?
  reversedAt     DateTime?

  advance      SalaryAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  payrollItem  PayrollItem?  @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)
  expense      Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([advanceId])
  @@index([payrollItemId])
  @@index([expenseId])
}

// =============================================================================
// 11. COMPLIANCE, TEMPLATES, GENERATED DOCUMENTS, REPORTS
// =============================================================================

/// Trade License, VAT/BIN, TIN, IRC, ERC... with renewal alerts. Renewing one
/// keeps the old record (supersededAt) and links the new one to it (previousId).
model ComplianceDocument {
  id               String         @id @default(cuid())
  companyId        String
  type             ComplianceType
  title            String
  number           String?
  issuingAuthority String?
  issueDate        DateTime?      @db.Date
  expiryDate       DateTime?      @db.Date
  alertDaysBefore  Int            @default(30)
  fileId           String?
  notes            String?
  /// The record this one renewed.
  previousId       String?        @unique
  /// Set when a renewal replaced it.
  supersededAt     DateTime?
  /// Taken off the list (kept for the history).
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  file      FileAsset?          @relation(fields: [fileId], references: [id], onDelete: SetNull)
  previous  ComplianceDocument? @relation("ComplianceRenewal", fields: [previousId], references: [id], onDelete: SetNull)
  renewal   ComplianceDocument? @relation("ComplianceRenewal")
  reminders Reminder[]

  @@index([companyId, expiryDate])
  @@index([companyId, type])
}

/// Uploaded custom template (PDF, Word, Image, HTML) for invoices, letterheads, etc.
model DocumentTemplate {
  id           String         @id @default(cuid())
  companyId    String
  name         String
  documentType DocumentType
  format       TemplateFormat
  fileId       String? // uploaded source (PDF/Word/Image)
  htmlContent  String? // for HTML templates
  /// PDF and image templates: each page's size in points ([{ width, height }]).
  pageSizes    Json?
  isDefault    Boolean        @default(false)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  file               FileAsset?            @relation(fields: [fileId], references: [id], onDelete: SetNull)
  placeholders       TemplatePlaceholder[]
  quotations         Quotation[]
  generatedDocuments GeneratedDocument[]

  @@unique([companyId, name])
  @@index([companyId, documentType])
}

/// Tag mapping, e.g. {CompanyName} -> company.name, {TotalAmount} -> doc.total.
model TemplatePlaceholder {
  id         String   @id @default(cuid())
  templateId String
  tag        String // "{BuyerName}"
  sourcePath String? // "buyer.name"; null = a tag not mapped yet (prints empty)
  format     String? // e.g. "upper", "date:dd MMM yyyy"
  pageX      Decimal? @db.Decimal(8, 2) // position for PDF/Image overlays (points from the top left)
  pageY      Decimal? @db.Decimal(8, 2)
  page       Int?
  fontSize   Int? // overlays: text size in points (default 10)
  bold       Boolean  @default(false)
  align      String? // overlays: "left" | "center" | "right" within `width`
  width      Decimal? @db.Decimal(8, 2) // overlays: box width; longer text is cut to fit

  template DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, tag])
}

/// Every PDF the system produces (quotations, PI, invoices, packing lists, challans,
/// stock availability shares, ledger & bank statements, letterhead pads, conveyance forms)
/// — gives permanent historical lookup and share tracking.
model GeneratedDocument {
  id            String           @id @default(cuid())
  companyId     String
  documentType  DocumentType
  referenceType String? // "Invoice", "Party", "Style"...
  referenceId   String?
  partyId       String?
  templateId    String?
  fileId        String?
  title         String
  periodFrom    DateTime?
  periodTo      DateTime?
  sharedVia     MessageChannel[]
  sharedAt      DateTime?
  /// SHA-256 of everything printed on it (and the logo): printing unchanged
  /// content again reuses this copy instead of making a new file.
  contentHash   String?
  /// What was asked for (stock sheet styles / brand / warehouse, statement dates).
  options       Json?
  generatedById String?
  createdAt     DateTime         @default(now())

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party       Party?            @relation(fields: [partyId], references: [id], onDelete: SetNull)
  template    DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  file        FileAsset?        @relation(fields: [fileId], references: [id], onDelete: SetNull)
  generatedBy User?             @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, contentHash])
  @@index([companyId, documentType, createdAt])
  @@index([referenceType, referenceId])
}

/// Report Builder: a downloadable PDF / Excel report for any period (1 week,
/// 1 month, 1 year or chosen days) with the chosen metrics. The file is kept
/// so it can be downloaded again; the row keeps who asked for what.
model ReportExport {
  id            String       @id @default(cuid())
  companyId     String
  requestedById String?
  title         String       @default("Business report")
  period        ReportPeriod
  fromDate      DateTime     @db.Date
  toDate        DateTime     @db.Date
  metrics       String[] // selected metric keys (see src/modules/reports/catalog.ts)
  options       Json? // limits and windows used (top sellers shown, slow-stock days)
  format        ReportFormat
  status        JobStatus    @default(QUEUED)
  fileId        String?
  error         String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy User?      @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  file        FileAsset? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

// =============================================================================
// 12. NOTEPAD, TASKS, REMINDERS, NOTIFICATIONS
// =============================================================================

/// Digital Notepad & Planner tabs: Daily Routine, Next 3 Days, General Notes.
model Note {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  tab       NoteTab
  title     String?
  content   String
  planDate  DateTime? @db.Date
  isDone    Boolean   @default(false)
  /// Daily routine items: the day they were last ticked (done today = today).
  doneOn    DateTime? @db.Date
  isPinned  Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, tab])
}

/// In-app task tracking (e.g. "Nazrul: factory visit on Tuesday").
model Task {
  id          String       @id @default(cuid())
  companyId   String
  title       String
  description String?
  assigneeId  String?
  createdById String?
  projectId   String?
  dueAt       DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  completedAt DateTime?
  /// When the assignee first opened it in My HR (the read receipt, "Seen");
  /// cleared when the task is given to someone else.
  seenAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee  Employee?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?              @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  project   ProductionProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@index([companyId, status, dueAt])
  @@index([assigneeId, status])
}

/// Trigger-based reminder (production deadline, goods in-house, shipment,
/// compliance expiry, factory visit...) delivered via WhatsApp / Email / In-app.
/// Set by hand (sourceKey null, may repeat) or made by a ReminderRule when a
/// date comes near (sourceKey says which date and step, so each fires once).
model Reminder {
  id                   String           @id @default(cuid())
  companyId            String
  type                 ReminderType
  title                String
  message              String?
  remindAt             DateTime
  repeatRule           String? // RRULE subset: FREQ, INTERVAL, BYMONTHDAY, UNTIL
  offsetDays           Int? // automatic: days before the date (negative = days after it)
  /// Automatic: the day of the deadline, delivery, shipment or expiry.
  dueDate              DateTime?        @db.Date
  /// Automatic: "<type>:<record>:<due day>:<step>", unique per company.
  sourceKey            String?
  status               ReminderStatus   @default(SCHEDULED)
  channels             MessageChannel[]
  projectId            String?
  orderId              String?
  purchaseOrderId      String?
  complianceDocumentId String?
  taskId               String?
  createdById          String?
  sentAt               DateTime?
  acknowledgedAt       DateTime?
  acknowledgedById     String?
  createdAt            DateTime         @default(now())

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project            ProductionProject?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order              SalesOrder?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purchaseOrder      PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  complianceDocument ComplianceDocument? @relation(fields: [complianceDocumentId], references: [id], onDelete: Cascade)
  task               Task?               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy          User?               @relation("ReminderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  acknowledgedBy     User?               @relation("ReminderAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  recipients         ReminderRecipient[]
  notifications      NotificationLog[]

  @@unique([companyId, sourceKey])
  @@index([companyId, status, remindAt])
  @@index([projectId])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([complianceDocumentId])
  @@index([taskId])
}

/// Company settings for one kind of automatic reminder (production deadlines,
/// goods in-house, shipments, licence expiry, task due dates). Without a row the
/// defaults in src/modules/reminders/rules.ts apply.
model ReminderRule {
  id               String       @id @default(cuid())
  companyId        String
  type             ReminderType
  isActive         Boolean      @default(true)
  /// Days before the date to remind, e.g. {7,3,1,0} (0 = on the day).
  daysBefore       Int[]
  /// Remind again every this many days once the date has passed (0 = never).
  overdueEveryDays Int          @default(1)
  /// Wall-clock time in company time when the reminders go out ("09:00").
  sendTime         String       @default("09:00")
  /// Everyone whose role can act on it (e.g. production.manage for deadlines).
  notifyManagers   Boolean      @default(true)
  /// The people on the record: who raised the purchase order, a task's assignee and creator.
  notifyOwner      Boolean      @default(true)
  /// More people to tell (user ids), and staff (employee ids: in-app through their login).
  userIds          String[]
  employeeIds      String[]
  updatedById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("ReminderRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, type])
}

/// Who gets a reminder: a management user and/or an assigned employee.
model ReminderRecipient {
  id         String  @id @default(cuid())
  reminderId String
  userId     String?
  employeeId String?

  reminder Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@index([userId])
  @@index([employeeId])
}

/// Outbound message log (WhatsApp Business API, Email, In-app). In-app
/// notifications are the rows with channel IN_APP and a userId: the inbox.
model NotificationLog {
  id                String         @id @default(cuid())
  companyId         String
  reminderId        String?
  channel           MessageChannel
  recipient         String // phone, email or user id
  /// In-app: the user whose inbox it is in.
  userId            String?
  /// The staff member it was for (also the WhatsApp / email target later).
  employeeId        String?
  subject           String?
  body              String
  /// The record it is about ("ProductionProject", "Task"...), to open it.
  entityType        String?
  entityId          String?
  status            DeliveryStatus @default(PENDING)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime       @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reminder Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, userId, createdAt])
  @@index([companyId, userId, readAt])
}

// =============================================================================
// 13. BACKUPS (system-wide, not per company)
// =============================================================================

/// Platform-wide backup settings (one row). Backups cover every company.
model BackupConfig {
  id                  String   @id @default(cuid())
  cronSchedule        String   @default("0 2 * * *") // daily at 02:00
  timezone            String   @default("Asia/Dhaka") // the schedule's clock
  includeMedia        Boolean  @default(true)
  googleDriveFolderId String? // folder the app created in the connected Drive
  googleDriveAccount  String? // email of the connected Google account
  credentialsRef      String? // encrypted Google refresh token (ENCRYPTION_KEY)
  retentionDays       Int      @default(30)
  isEnabled           Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model BackupRun {
  id               String        @id @default(cuid())
  trigger          BackupTrigger
  status           JobStatus     @default(QUEUED)
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  dbDumpPath       String?
  mediaArchivePath String?
  sizeBytes        BigInt?
  driveFileId      String? // Google Drive folder holding this run's files
  driveError       String? // set when the files were saved on the server but not on Drive
  filesDeletedAt   DateTime? // local files removed by the retention rule
  triggeredById    String?
  error            String?

  triggeredBy User? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([startedAt])
}

